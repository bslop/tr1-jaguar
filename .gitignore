mrt.h
mrt_lara.h
mrt_spawn.h
gym.h
gym_lara.h
gym_spawn.h
sfx.h
pass.h
photo.h
room0_tex.h
textures.h

# ── Build products ─────────────────────────────────────────────────────
build/

# ── Development attic (WIP/backup variants kept locally, not in git) ───
*_pre*.c
*_pre*.das
*_pre*.gas
