mrt.h
mrt_lara.h
mrt_spawn.h
gym.h
gym_lara.h
gym_spawn.h
sfx.h
pass.h
photo.h
room0_tex.h
textures.h

# ── Build products ─────────────────────────────────────────────────────
build/

# ── Development attic (WIP/backup variants kept locally, not in git) ───
*_pre*.c
*_pre*.das
*_pre*.gas
*_WIP*.gas
*_BROKEN*.gas
*_dietonly.gas
*_surgeries.gas
*_halfA.gas
*.bak
__pycache__/
*.pyc

# converter output (SD-card payload)
GameDrive_SD/
TombRaider-Jaguar/
music_variants/

# ── Kernel working snapshots & scratch (kept locally, not in git) ──────
# pre-campaign backups: gpu_geotex.gas.prejopt/.prerect/.reloc/.working/... etc
gpu_geotex.gas.*
*.working
# scratch jsim probe output
jsim_*.json
jsim_*.err
# transient diagnostic screenshots
probes/*.png
probes/**/*.png

# per-tag ROM sets from tools/gbuild.sh (one .cof per A10 pad)
build_*/

# ring item: the Jaguar controller is an ORIGINAL model (no disc content),
# so unlike every other *_geom/_atlas blob it ships with the repo.
!ctrl_geom.bin
!ctrl_atlas.bin
mrt_gunanim.h

# Generated by the extractor from the user's disc (this repo ships no game data).
# gym_bear.h/gym_lplanes.h appeared when Lara's Home extraction was revived;
# mrt_sect.bin.prepatch is the boundary-patch backup. All three are rebuilt by
# tools/build_cof.sh, so committing them would ship level data AND go stale.
gym_bear.h
gym_lplanes.h
*.prepatch

# ☠️ DISC-DERIVED CONTENT LIVES IN disc/ AND IS NEVER COMMITTED
# (user's call, 2026-08-19, after 43 MB of it was purged from the public repo)
# Everything under disc/ is transcoded or extracted from the user's own Tomb
# Raider disc: the four FMV clips (Eidos/Core footage), the PS1 loading art,
# and the extractor's level/model/texture output. tools/build_cof.sh and the
# Docker image regenerate all of it from a disc the user supplies - that is the
# whole design, and it is why none of it belongs in the repo.
# Referenced as disc/<name> by mrt_data.S / room0data.S (.incbin) and found by
# #include via -Idisc (Makefile).
/disc/
cobweb/

# ☠☠ BUILD-OUTPUT / MEASUREMENT-ARM DIRECTORIES — DISC-DERIVED, NEVER COMMIT
# Every container run and every A/B arm drops a full SD payload: OPENLARA.elf
# (the linked image, with the disc's level/texture/model data .incbin'd into
# it), CAVSLOAD.DAT / GYMLOAD.DAT (loading art), the .JV clips and MUSIC.PCM.
# `*.cof` and `*.bin` were already ignored; `.elf` and `.DAT` were NOT, so 28
# untracked paths of disc-derived material were sitting one `git add -A` away
# from a PUBLIC repo (2026-09-06). 43 MB of exactly this had to be purged once
# before — see the /disc/ note above.
# ★ Named by PREFIX rather than one-by-one: the next arm will be called
# something nobody has thought of yet, and a rule that needs updating per
# experiment is a rule that fails on the experiment nobody edited it for.
out/
out_*/
arm[0-9]*/
br_*/
wolf_*/
*.elf
*.DAT
*.JV

# ☠ DISC-DERIVED CAPTURES AND GOLDENS — origin is PUBLIC (bslop/tr1-jaguar).
# A capture of the running engine is the disc's art on a screen, and a decoded
# framebuffer golden is a frame of the disc's FMV. Neither is ours to publish.
# 29 MB of climb-harness video and 157 extracted frames were tracked from
# 2026-08-16 until 2026-09-10; they now live in the private jaguar-evidence
# repo, which is where jaguar-shared/case-studies/EVIDENCE.md says ROM-derived
# material goes ("everything else is ROM-derived and lives in the private
# jaguar-evidence repo").
# ★ ctrl_geom.bin / ctrl_atlas.bin are NOT covered: tools/gen_jagpad.py
# generates them to REPLACE the PSX controller item, so they are our own work.
climbmatrix/
*.golden
*.mkv
*.mp4
*.wav
noname.o

# ☠☠ BUILD OUTPUT IS DISC-DERIVED. A built ROM contains the level geometry,
# atlas and audio EXTRACTED from the disc — publishing OPENLARA.COF publishes
# the game's art. On 2026-09-10 there were 262 MB of these sitting untracked
# and UNIGNORED (demo34..demo62 plus the a1_/a5_/a9_/br2_/ds_ experiment arms),
# one `git add -A` from origin, which is public.
# ★ Ignored by PAYLOAD TYPE as well as by directory prefix, following this
# file's own rule above: the next arm will have a name nobody has thought of
# yet, but it will still contain a .COF.
# ☠ Deliberately NOT *.bin — ctrl_geom.bin / ctrl_atlas.bin are ours
# (tools/gen_jagpad.py builds the Jaguar pad that REPLACES the PSX item).
*.COF
*.cof
*.PCM
*.LEV
demo*/
a[0-9]_*/
br[0-9]_*/
ds_*/
mb_*/
play_*/
vol_*/
yd*/
_openlara_evidence/
