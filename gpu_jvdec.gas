; gpu_jvdec.gas - JV04 boot-FMV VECTOR-QUANTIZATION decoder on Tom.
;
; (v2 - replaces the JV02 RLE engine. User: "I'd like to have the original
; videos from the disc" - VQ carries NATIVE 320x240 inside the ~37KB/s
; GameDrive envelope: 4x4-pixel blocks resolved against a per-clip
; 256-entry codebook; temporal skip tokens carry unchanged blocks.)
;
; Stream tokens over the 80x60 block grid:
;   t < 128  -> copy t+1 blocks: that many codebook-index bytes follow
;   t >= 128 -> skip t-127 blocks (previous frame persists on screen)
;
; Every copied block is written to BOTH framebuffers (fbA and fbB), so the
; display ping-pong stays coherent without band bookkeeping: frame 0 is a
; full copy, and every change lands in both buffers thereafter.
;
; params $F03F00:
;   +0 token src (DRAM)      +4  token bytes
;   +8 codebook base (4KB)   +12 fbA    +16 fbB
;   +32 OUT done magic       +36 OUT hello magic
;
; Discipline: 2 nops after loads; far/hot branch targets in registers;
; short forward skips jr. TEST=1: DRAM build (org $4000) with embedded
; codebook+payload, fbA/fbB at $20000/$40000 for jtest capture.

PARAMS      .equ    $F03F00
MAGIC_HELLO .equ    $0A3D0001
MAGIC_DONE  .equ    $0A3DD05E

TFBA        .equ    $20000
TFBB        .equ    $40000

	.gpu
.if TEST
	.org	$4000
.else
	.org	$F03000
.endif

start:
.if TEST
	movei	#tpay,r4		; src
	movei	#tpayend,r5
	sub	r4,r5			; len
	movei	#tcb,r6			; codebook
	movei	#TFBA,r7		; fbA
	movei	#TFBB,r8		; fbB
.else
	movei	#PARAMS,r1
	nop
	load	(r1),r4			; src
	addq	#4,r1
	load	(r1),r5			; len
	addq	#4,r1
	load	(r1),r6			; codebook base
	addq	#4,r1
	load	(r1),r7			; fbA
	addq	#4,r1
	load	(r1),r8			; fbB
	nop
	nop
	movei	#PARAMS+36,r0
	movei	#MAGIC_HELLO,r2
	store	r2,(r0)
.endif

	moveq	#0,r12			; bx = block col (0..79)
	movei	#4800,r13		; blocks remaining
	movei	#.tok,r18
	movei	#.done,r19
	movei	#.skip,r20
	movei	#.cloop,r21
	movei	#.adv,r22		; shared block-advance helper
	movei	#320,r23
	movei	#960,r24		; row stride to line +3

.tok:
	cmpq	#0,r5
	jump	EQ,(r19)		; payload exhausted -> done
	nop
	nop
	cmpq	#0,r13
	jump	EQ,(r19)		; all blocks covered -> done
	nop
	nop
	loadb	(r4),r9			; token
	addq	#1,r4
	subq	#1,r5
	nop
	nop
	movei	#128,r0
	cmp	r0,r9
	jump	PL,(r20)		; t >= 128 -> skip run
	nop
	nop
	move	r9,r11
	addq	#1,r11			; n = t+1 copies

.cloop:
	cmpq	#0,r11
	jump	EQ,(r18)		; run done -> next token
	nop
	nop
	cmpq	#0,r13
	jump	EQ,(r19)
	nop
	nop
	cmpq	#0,r5
	jump	EQ,(r19)		; stream guard
	nop
	nop
	loadb	(r4),r10		; codebook index
	addq	#1,r4
	subq	#1,r5
	nop
	nop
	shlq	#4,r10			; *16
	add	r6,r10			; entry base
	load	(r10),r14		; row 0 (4 px)
	addq	#4,r10
	load	(r10),r15		; row 1
	addq	#4,r10
	load	(r10),r16		; row 2
	addq	#4,r10
	load	(r10),r17		; row 3
	nop
	nop
	; write the block to fbA
	move	r7,r0
	store	r14,(r0)
	add	r23,r0
	store	r15,(r0)
	add	r23,r0
	store	r16,(r0)
	add	r23,r0
	store	r17,(r0)
	; and to fbB
	move	r8,r0
	store	r14,(r0)
	add	r23,r0
	store	r15,(r0)
	add	r23,r0
	store	r16,(r0)
	add	r23,r0
	store	r17,(r0)
	subq	#1,r11
	movei	#.cloop,r2
	jump	T,(r22)			; advance one block, return to (r2)
	nop
	nop

.skip:
	move	r9,r11
	movei	#127,r0
	sub	r0,r11			; n = t-127
.sloop:
	cmpq	#0,r11
	jump	EQ,(r18)
	nop
	nop
	cmpq	#0,r13
	jump	EQ,(r19)
	nop
	nop
	subq	#1,r11
	movei	#.sloop,r2
	jump	T,(r22)			; advance one block, return to (r2)
	nop
	nop

; ---- advance one block: dst += 4; end of block row -> next 4 lines ----
.adv:
	addq	#4,r7
	addq	#4,r8
	subq	#1,r13
	addq	#1,r12
	movei	#80,r0
	cmp	r0,r12			; bx - 80
	jump	MI,(r2)			; still in the row -> back to caller
	nop
	nop
	moveq	#0,r12
	add	r24,r7			; skip lines +1..+3 (already +320 via 80*4)
	add	r24,r8
	jump	T,(r2)
	nop
	nop

.done:
.if TEST
	nop
.else
	movei	#PARAMS+32,r1
	movei	#MAGIC_DONE,r0
	store	r0,(r1)
.endif
	nop
	nop
.halt:
	nop
	jr	T,.halt
	nop
	nop

.if TEST
	.align	4
tcb:
	.incbin	"jvtest_cb.bin"
tpay:
	.incbin	"jvtest_payload.bin"
tpayend:
	.long	0
.endif
