; gpu_jvdec.gas - JV04 boot-FMV VECTOR-QUANTIZATION decoder on Tom.
;
; (v2 - replaces the JV02 RLE engine. User: "I'd like to have the original
; videos from the disc" - VQ carries NATIVE 320x240 inside the ~37KB/s
; GameDrive envelope: 4x4-pixel blocks resolved against a per-clip
; 256-entry codebook; temporal skip tokens carry unchanged blocks.)
;
; Stream tokens over the 80x60 block grid:
;   t < 128  -> copy t+1 blocks: that many codebook-index bytes follow
;   t >= 128 -> skip t-127 blocks (previous frame persists on screen)
;
; Every copied block is written to BOTH framebuffers (fbA and fbB), so the
; display ping-pong stays coherent without band bookkeeping: frame 0 is a
; full copy, and every change lands in both buffers thereafter.
;
; params $F03F00:
;   +0 PREV token src  +4 PREV bytes   (frame N-1, re-applied: the back
;                                       buffer is two frames stale)
;   +8 CUR  token src  +12 CUR bytes
;   +16 codebook base  +20 fb (BACK buffer ONLY - writing the displayed
;                              buffer mid-scan flashed on the CRT)
;   +32 OUT done magic +36 OUT hello magic
;
; Discipline: 2 nops after loads; far/hot branch targets in registers;
; short forward skips jr. TEST=1: DRAM build (org $4000) with embedded
; codebook+payload, fbA/fbB at $20000/$40000 for jtest capture.

PARAMS      .equ    $F03F00
MAGIC_HELLO .equ    $0A3D0001
MAGIC_DONE  .equ    $0A3DD05E

TFBA        .equ    $20000
TFBB        .equ    $40000

	.gpu
.if TEST
	.org	$4000
.else
	.org	$F03000
.endif

start:
.if TEST
	movei	#tpay,r26		; PREV pass = the same payload
	movei	#tpayend,r27
	sub	r26,r27
	movei	#tpay2,r28		; CUR pass
	movei	#tpay2end,r29
	sub	r28,r29
	movei	#tcb,r6			; codebook
	movei	#TFBA,r30		; fb
.else
	movei	#PARAMS,r1
	nop
	load	(r1),r26		; prev src
	addq	#4,r1
	load	(r1),r27		; prev len
	addq	#4,r1
	load	(r1),r28		; cur src
	addq	#4,r1
	load	(r1),r29		; cur len
	addq	#4,r1
	load	(r1),r6			; codebook base
	addq	#4,r1
	load	(r1),r30		; fb (back buffer only)
	nop
	nop
	movei	#PARAMS+36,r0
	movei	#MAGIC_HELLO,r2
	store	r2,(r0)
.endif

	moveq	#0,r25			; pass 0 = prev, 1 = cur
	movei	#.passtop,r31

.passtop:
	cmpq	#0,r25
	jr	NE,.p_cur
	nop
	nop
	move	r26,r4			; pass 0: prev tokens
	move	r27,r5
	jr	T,.p_go
	nop
	nop
.p_cur:
	move	r28,r4			; pass 1: current tokens
	move	r29,r5
.p_go:
	move	r30,r7			; fb walk restarts each pass
	moveq	#0,r12			; bx = block col (0..79)
	movei	#4800,r13		; blocks remaining
	movei	#.tok,r18
	movei	#.done,r19
	movei	#.skip,r20
	movei	#.cloop,r21
	movei	#.adv,r22		; shared block-advance helper
	movei	#320,r23
	movei	#960,r24		; row stride to line +3

.tok:
	cmpq	#0,r5
	jump	EQ,(r19)		; payload exhausted -> done
	nop
	nop
	cmpq	#0,r13
	jump	EQ,(r19)		; all blocks covered -> done
	nop
	nop
	loadb	(r4),r9			; token
	addq	#1,r4
	subq	#1,r5
	nop
	nop
	movei	#128,r0
	cmp	r0,r9
	jump	PL,(r20)		; t >= 128 -> skip run
	nop
	nop
	move	r9,r11
	addq	#1,r11			; n = t+1 copies

.cloop:
	cmpq	#0,r11
	jump	EQ,(r18)		; run done -> next token
	nop
	nop
	cmpq	#0,r13
	jump	EQ,(r19)
	nop
	nop
	cmpq	#0,r5
	jump	EQ,(r19)		; stream guard
	nop
	nop
	loadb	(r4),r10		; codebook index
	addq	#1,r4
	subq	#1,r5
	nop
	nop
	shlq	#4,r10			; *16
	add	r6,r10			; entry base
	load	(r10),r14		; row 0 (4 px)
	addq	#4,r10
	load	(r10),r15		; row 1
	addq	#4,r10
	load	(r10),r16		; row 2
	addq	#4,r10
	load	(r10),r17		; row 3
	nop
	nop
	; write the block (back buffer only)
	move	r7,r0
	store	r14,(r0)
	add	r23,r0
	store	r15,(r0)
	add	r23,r0
	store	r16,(r0)
	add	r23,r0
	store	r17,(r0)
	subq	#1,r11
	movei	#.cloop,r2
	jump	T,(r22)			; advance one block, return to (r2)
	nop
	nop

.skip:
	move	r9,r11
	movei	#127,r0
	sub	r0,r11			; n = t-127
.sloop:
	cmpq	#0,r11
	jump	EQ,(r18)
	nop
	nop
	cmpq	#0,r13
	jump	EQ,(r19)
	nop
	nop
	subq	#1,r11
	movei	#.sloop,r2
	jump	T,(r22)			; advance one block, return to (r2)
	nop
	nop

; ---- advance one block: dst += 4; end of block row -> next 4 lines ----
.adv:
	addq	#4,r7
	subq	#1,r13
	addq	#1,r12
	movei	#80,r0
	cmp	r0,r12			; bx - 80
	jump	MI,(r2)			; still in the row -> back to caller
	nop
	nop
	moveq	#0,r12
	add	r24,r7			; skip lines +1..+3 (already +320 via 80*4)
	jump	T,(r2)
	nop
	nop

.done:
	cmpq	#0,r25
	jr	NE,.alldone
	nop
	nop
	moveq	#1,r25			; second pass: current frame
	jump	T,(r31)
	nop
	nop
.alldone:
.if TEST
	nop
.else
	movei	#PARAMS+32,r1
	movei	#MAGIC_DONE,r0
	store	r0,(r1)
.endif
	nop
	nop
.halt:
	nop
	jr	T,.halt
	nop
	nop

.if TEST
	.align	4
tcb:
	.incbin	"jvtest_cb.bin"
tpay:
	.incbin	"jvtest_payload.bin"
tpayend:
	.long	0
	.align	4
tpay2:
	.incbin	"jvtest_payload2.bin"
tpay2end:
	.long	0
.endif
