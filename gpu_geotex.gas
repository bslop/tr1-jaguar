; gpu_geotex.gas - Tom GPU reads TEXTURED room geometry from DRAM, transforms /
; projects / culls every face ON TOM (the 68000 does NO per-vertex work), and
; BLITTER-hardware-texture-maps the spans.  This is the doctrine-pure textured
; endpoint: it COMBINES two HW-verified kernels, reusing their proven code:
;
;   * gpu_geomdirect.gas  -> the per-polygon TRANSFORM + PROJECT + NEAR-CULL +
;                            screen-area BACKFACE-CULL front-end (render_pkt's
;                            vloop + backface test), plus stage_vert's RVert
;                            lookup and the shared chain_step / imul32.
;   * gpu_bltex.gas       -> the two-chain edge-walk that carries (u,v) as a
;                            16.16 DDA per chain (uv_edge), and the per-span
;                            BLITTER textured fill (A1 = fractional texture
;                            sampler, A2 = fb dest, DSTA2).  BYTE-IDENTICAL to
;                            gpu_bltex - the proven textured span.
;
; HOW THE PIECES FUSE
;   read geometry (verts + per-face UVs from DRAM)
;     -> stage each face's verts as WORLD (x+offX<<8, y, z+offZ<<8) into WBUF
;        AND copy the face's per-vertex (u,v) UNCHANGED into U_BUF/V_BUF
;     -> render_pkt: TRANSFORM+PROJECT each world vert to screen (sx,sy) in
;        SX_BUF/SY_BUF, near-cull, backface-cull   [gpu_geomdirect]
;     -> edge-walk interpolating BOTH x (chain_step) AND (u,v) (uv_edge) down
;        the two chains, then per span program the Blitter texture-map [gpu_bltex]
;
;   >>> UVs ARE NEVER TRANSFORMED. <<<  They come straight from the geometry
;   (atlas texel units), land in U_BUF/V_BUF as the (u,v) for that SCREEN vertex,
;   and flow verbatim through uv_edge -> the per-span du/dv -> A1_PIXEL/FPIXEL/
;   INC/FINC.  render_pkt only touches SX_BUF/SY_BUF; U_BUF/V_BUF survive it.
;
; ===================================================================
; INPUT GEOMETRY: room0_tex.bin  (single room, BIG-ENDIAN; see room0_tex.h)
; ===================================================================
;   HEADER (16 bytes):
;     +0  u16 vcount   +2  u16 qcount  +4  u16 tcount
;     +6  u16 atlasW   +8  u16 atlasH
;     +10 s16 offX     +12 s16 offY(0) +14 s16 offZ   (offX/offZ PACKED >>8)
;   VERTS  (vcount*8):  +0 s16 x, +2 s16 y, +4 s16 z, +6 u16 shade(IGNORED)
;   QUADS  (qcount*24): +0 u16 v0,v1,v2,v3  then +8 u16 u0,v0,u1,v1,u2,v2,u3,v3
;   TRIS   (tcount*18): +0 u16 v0,v1,v2     then +6 u16 u0,v0,u1,v1,u2,v2
;   World vertex = (x + (offX<<8), y, z + (offZ<<8)).   offY=0 -> no Y offset.
;   UVs are already per-vertex, in atlas texel units (0..atlasW-1 / 0..atlasH-1);
;   passed straight to the edge-walk as the (u,v) for that screen vertex.
;   NB: quad/tri record size = 2*n (indices) + 4*n (uv pairs) = 6*n bytes
;       (quad=24, tri=18).  All fields are 2-byte -> read with LOADW.
;
; ===================================================================
; PARAM BLOCK  (68000 side, $F03F00, big-endian, 7 longs)
; ===================================================================
;   [0] = room0_tex base ptr  (DRAM; the kernel reads vcount/qcount/tcount/
;                              offX/offZ from the blob's own 16-byte header)
;   [1] = mailbox    (DRAM: [0]=done magic, [1]=hello magic)
;   [2] = UNUSED     (counts live in the room0_tex header, not here)
;   [3] = framebuffer base   (8bpp indexed, 320 wide, PHRASE-aligned)
;   [4] = camera-block ptr   (7 s32: cY4,sY4,cP4,sP4,camx,camy,camz)
;   [5] = atlas base         (8bpp indexed texel atlas, PHRASE-aligned)
;   [6] = atlas_width        (raw texel stride; encoded into the A1 WID flag
;                             here - MUST be a Blitter-encodable width, 256 ideal)
;   mailbox (DRAM): [0]=done magic $0A3DD05E, [1]=hello magic $0A3D0001.
;
; DESIGN CHOICE - READ VERTS PER-FACE (not buffer all).
;   vcount can be up to 311 (room 0); buffering all transformed screen verts
;   would need >2.4KB of the 256-byte scratch band.  Instead, like gpu_geomdirect,
;   each face STAGES its 3-4 world verts into WBUF and render_pkt transforms just
;   those (SX/SY/U/V stay at 4 entries).  Shared verts are re-transformed per
;   face - the doctrine-simple, scratch-cheap, proven path.
;
; ===================================================================
; SRAM MAP  (code $F03000.., scratch band $F03E00.., params $F03F00)
;   packed so all borrowed code stays VERBATIM (buffers are referenced by
;   symbol, so tightening the .equ addresses touches no instruction).
; ===================================================================
;   SX_BUF  $F03E00  4 longs  screen x (int)      ] render_pkt writes these;
;   SY_BUF  $F03E10  4 longs  screen y (int)      ] edge-walk reads them
;   U_BUF   $F03E20  4 longs  per-vertex u (int)  ] staging writes these,
;   V_BUF   $F03E30  4 longs  per-vertex v (int)  ] uv_edge reads them
;   AU..AVSL $F03E40 4 longs  chain A u/v DDA  (AU,AUSL,AV,AVSL 16.16)
;   BU..BVSL $F03E50 4 longs  chain B u/v DDA  (BU,BUSL,BV,BVSL 16.16)
;   WBUF    $F03E60  13 longs staged packet: hdr(n<<16) + 4*3 world s32
;   CAM_BUF $F03E98  7 longs  cY4,sY4,cP4,sP4,camx,camy,camz
;   RVBASE  $F03EB4  verts base ptr   (= room + 16)
;   QBASE   $F03EB8  quads base ptr   (= RVBASE + vcount*8)
;   TBASE   $F03EBC  tris  base ptr   (= QBASE + qcount*24)
;   QCNT    $F03EC0  quad count       TCNT $F03EC4 tri count
;   OFFXW   $F03EC8  offX<<8 (s32)    OFFZW $F03ECC offZ<<8 (s32)
;   FACE_LEFT $F03ED0  faces remaining in current quad/tri phase
;   FACE_CUR  $F03ED4  DRAM cursor into current quad/tri table
;   FACE_N    $F03ED8  vertices this phase (4 quads / 3 tris)
;   RET_PHASE $F03EE0  where to go when a phase's FACE_LEFT hits 0
;   (highest byte used $F03EE3 < $F03F00 params.  Code must end < $F03E00.)
;
; ===================================================================
; DIV MODES (G_DIVCTRL, scoreboarded div; toggled exactly as the sources do)
;   * transform PROJECTION divides (sx=rx*FOCAL/rz2, sy=ry*FOCAL_Y/rz2):
;       INTEGER mode (=0), signed-numerator abs/neg dance   [gpu_geomdirect]
;   * edge-slope divides (chain_step x-slope, uv_edge u/v-slope):
;       16.16 mode (=1)                                     [both kernels]
;   * per-span du/dv gradient (uR-uL)/denom, (vR-vL)/denom:
;       INTEGER mode (=0) then RESTORED to 16.16            [gpu_bltex verbatim]
;
; ===================================================================
; BLITTER TEXTURE PROGRAM  == gpu_bltex, BYTE-IDENTICAL (the proven part):
;   A1 = TEXTURE source, XADDINC (fractional affine sampler; A1_PIXEL=(v<<16)|u,
;        A1_FPIXEL fraction, A1_INC=(dv_int<<16)|du_int, A1_FINC fraction).
;   A2 = SCREEN dest, XADDPIX (+1 dest pixel/step).
;   B_CMD = SRCEN|LFU_REPLACE|DSTA2 = $01800801  (DSTA2 -> A2 written, A1 read).
;   atlas_width -> A1 WID field encoded at startup (e=floor(log2 w); m=(w>>(e-2))
;   &3; field=((e<<2)|m)<<9).  No SRCSHADE/GOURD: they would corrupt an 8bpp
;   palette INDEX.  Both A1 U and V step & carry per dest pixel -> full affine.
;
; ===================================================================
; HAZARD DISCIPLINE (identical to both sources): assembled at true SRAM origin
;   so `movei #label` resolves; >=2 instrs after a load before using it; 2 nops
;   after MULT before reading the product (imul32); DIV scoreboarded (result not
;   read until ready); only MI/PL/EQ/NE/T/CS conditions; forward/long branches
;   via movei #label,rN ; jump cc,(rN) ; nop ; nop.  Backward jr only for halt.
;   Blitter regs are LONG (32-bit) accesses.
; ===================================================================

G_DIVCTRL	.equ	$F0211C

; Blitter registers (JAGUAR.INC, base $F02200) - same set gpu_bltex uses
A1_BASE		.equ	$F02200
A1_FLAGS	.equ	$F02204
A1_PIXEL	.equ	$F0220C
A1_FPIXEL	.equ	$F02218
A1_INC		.equ	$F0221C
A1_FINC		.equ	$F02220
A2_BASE		.equ	$F02224
A2_FLAGS	.equ	$F02228
A2_PIXEL	.equ	$F02230
B_CMD		.equ	$F02238
B_COUNT		.equ	$F0223C

; A1/A2 flag pieces (gpu_bltex verbatim)
.if FOURBPP=1
; 4bpp texture atlas (2026-08-04): the PSX source is natively 16-colour/4bpp;
; keep it 4bpp so the Blitter reads HALF the texture bytes (this renderer is
; bus-bound). PIXSIZE field (bits 5:3) 3->2. WID is still 256 PIXELS (OR'd at
; startup); the Blitter halves the byte pitch/address from the pixel-size flag.
; Dest framebuffer stays 8bpp, so texels index CLUT entries 0..15 (16-colour).
A1_FIXED	.equ	$00030010	; PIXEL4 | XADDINC
.else
A1_FIXED	.equ	$00030018	; PIXEL8 | XADDINC (WID OR'd in at startup)
.endif
.if PHRASEDST=1
; PHRASE-MODE DEST PROBE (2026-07-28).  jagemu's blit model prices a transfer at
; (dst_accesses + src_accesses) x 5.6 ticks, and `ppp` is 1 whenever xadd != 0 --
; i.e. PIXEL mode costs ONE ACCESS PER PIXEL per stream.  Our textured span runs
; XADDPIX with SRCEN, so it pays 2 accesses/pixel = 11.2 ticks/px; a 9-px span is
; 16 (launch) + 101 = ~117 ticks.  Phrase mode is 8 px per access, so a phrase
; DEST would cost (npix/8 + npix) x 5.6 = 6.3 ticks/px -- about 44% less Blitter
; time.  Launch is only 16 of 117 ticks (14%), which is independently why
; batching (RUNBATCH/TRAPEZOID) measured null: it only removes launches.
;   *** TWO THINGS COULD SINK THIS, AND ONLY SILICON DECIDES THE SECOND ***
;   1. ALIGNMENT: a phrase dest steps 8 px at a time, so it can only write
;      aligned 8-px groups.  Our spans start at arbitrary x and average 9 px.
;   2. Whether the Blitter can assemble 8 GATHERED source pixels (XADDINC
;      sampler) into one dest phrase at all.  jagemu will happily apply its
;      formula either way -- in-kernel silicon testing is the only real probe.
; Check (1) in the emulator first; it is free and it can kill this outright.
A2_FLAGS_VAL	.equ	$00004218	; PITCH1|PIXEL8|WID320|XADDPHR (probe)
.else
A2_FLAGS_VAL	.equ	$00014218	; PITCH1|PIXEL8|WID320|XADDPIX
.endif
BCMD_TEX	.equ	$01800801	; SRCEN|LFU_REPLACE|DSTA2
BLIT_GUARD	.equ	200000		; bounded wait-for-idle spins

MAGIC_HELLO	.equ	$0A3D0001
MAGIC_DONE	.equ	$0A3DD05E

; projection constants (LOWRES-aware, exactly like gpu_geomdirect).  X never
; scaled; the OP hardware scaler stretches a 320x120 fb 2x vertically in LOWRES,
; so only CENTER_Y/FOCAL_Y/YMAX change.  rmac has no .ifdef -> LOWRES is ALWAYS
; passed as 0 or 1 (Makefile LOWRES_DEF := -dLOWRES=0/1).
; VRESN=N (2026-08-11) - the RESOLUTION DIAL.  Render N lines and let the OP
; scaler stretch them over the 240-line window.  FOCAL_Y MUST carry the same
; ratio as the compression (190*N/240) or the vertical FOV changes and the
; world renders too tall - the trap VRES60's comment records.  Enumerated
; because jas takes -d only for .if comparisons, never as a value.
	.if	LOWRES
	.if VRESN=96
RENDER_H	.equ	96
FOCAL_Y		.equ	76		; 190*96/240, OP scales 2.5x
	.else
	.if VRESN=80
RENDER_H	.equ	80
FOCAL_Y		.equ	63		; 190*80/240
	.else
	.if VRESN=64
RENDER_H	.equ	64
FOCAL_Y		.equ	51		; 190*64/240
	.else
	.if VRESN=60
RENDER_H	.equ	60
FOCAL_Y		.equ	47		; 190*60/240 (47.5, floored to match VRES60)
	.else
	.if VRES60=1
RENDER_H	.equ	60
FOCAL_Y		.equ	47		; FOCAL/4 - the OP stretches 4x vertically.
					; MUST scale with the compression: halving
					; RENDER_H/CENTER_Y alone halves the vertical
					; FIELD OF VIEW, so the world renders 2x
					; too tall and the camera reads as zoomed
					; right in on Lara (user spotted it).
	.else
RENDER_H	.equ	120
FOCAL_Y		.equ	95		; FOCAL/2 (vertical axis compressed 2x)
	.endif
	.endif
	.endif
	.endif
	.endif
	.else
RENDER_H	.equ	240
FOCAL_Y		.equ	190		; = FOCAL (no vertical scaling)
	.endif
; VIEWH (2026-08-11): the world is drawn into the TOP VIEW_H lines only, the
; rest of the buffer is left black for a Doom-style status bar.  VIEWH=0 (the
; default) makes VIEW_H == RENDER_H and every constant below is unchanged.
; ☠️ CENTER_Y follows the band but FOCAL_Y does NOT - that is deliberate.  This
; is a CROP: the vertical FOV shrinks with the band, so faces that leave it are
; killed by the empty-y-range / YMAX early-outs rather than rasterized.  Scaling
; FOCAL_Y with it (what VRES60 above has to do, because the OP stretches those
; 60 lines back over the whole window) would keep the FOV and squash the world
; instead - the same pixel count for no front-end saving.
; ☠️ THE LADDER IS ENUMERATED, and it has to be: jas takes -d NAME=VALUE only
; for `.if` COMPARISONS - the name is not a symbol and `VIEW_H .equ VIEWH` is an
; undefined-symbol error (probed 2026-08-11).  So every band height a build may
; ask for needs a branch here, and the Makefile refuses any VIEWH outside the
; list rather than let one fall through to full height - a lever that silently
; does nothing is the "verify the flag landed" trap in its purest form.
	.if VIEWH=0
VIEW_H		.equ	RENDER_H
	.else
	.if VIEWH=108
VIEW_H		.equ	108
	.else
	.if VIEWH=100
VIEW_H		.equ	100
	.else
	.if VIEWH=96
VIEW_H		.equ	96
	.else
	.if VIEWH=90
VIEW_H		.equ	90
	.else
	.if VIEWH=84
VIEW_H		.equ	84
	.else
	.if VIEWH=80
VIEW_H		.equ	80
	.else
	.if VIEWH=72
VIEW_H		.equ	72
	.else
	.if VIEWH=60
VIEW_H		.equ	60
	.else
VIEW_H		.equ	VIEWH_NOT_ON_THE_LADDER_SEE_THE_MAKEFILE
	.endif
	.endif
	.endif
	.endif
	.endif
	.endif
	.endif
	.endif
	.endif
CENTER_Y	.equ	(VIEW_H/2)
YMAX		.equ	(VIEW_H-1)	; edge-walk bottom clamp
CENTER_X	.equ	160
FOCAL		.equ	190		; TR1's ~80-degree FOV (160 was 90:
					; too wide -> world read as too far)
.if NEARLOW=1
; NEARLOW (2026-07-30): near plane 64 -> 16 to test the whole-face rejection
; BEXIT performs. There is NO near-plane CLIPPING, so a large face loses ALL of
; itself the moment ONE vertex crosses NEAR - which pops big slant-edged holes
; in nearby floor/wall geometry as the camera moves, exactly the artifact seen
; to Lara's left. Lowering NEAR shrinks the band where that happens; it does not
; cure it (the real fix is clipping the polygon at z = NEAR).
; NOTE: main.c defines NEAR as 32 while this file used 64 - they DISAGREE
; despite the comment saying they must match.
; (jas takes -d symbols in .if but NOT as an .equ operand, hence a boolean
; flag with literal values rather than a numeric NEARZ.)
NEAR		.equ	16
.else
NEAR		.equ	64		; raised 32->64: shrinks the near-face SMEAR
.endif
					; zone (must match dsp_pose RX_NEAR + main.c)

; SRAM layout (packed; see header comment)
PARAMS		.equ	$F03F00
SX_BUF		.equ	$F03F24		; MOVED from $F03E00 (2026-07-20) into the
					; free hole after SHADEK to raise the code
					; ceiling 3584->3600 for the SHADEPASS code.
					; $F03F24-$F03F33; $F03F34-3F still free.
					; (Single-var move, NOT the reverted repack;
					; verified 0-px on the PROFILE+AUTOSTART
					; multi-room dispatch build.)
; SY/U/V RELOCATED 2026-07-20 into the freed dispatch-list tail (list is
; 5 entries now, ends $F03FC8): raises the code floor F03E10 -> F03E40,
; ceiling 3600 -> 3648 bytes. v3: buffers END at $F03FF7 — the range the
; old 8-entry dispatch list proved writable on silicon; $F03FF8+ is
; UNPROVEN (v1 put V_BUF's last long there = streak suspect). SH_Y0
; lives in the $F03F38 scrap.
SY_BUF		.equ	$F03FC8
U_BUF		.equ	$F03FD8
V_BUF		.equ	$F03FE8
; !!! $F03F74-$F03FF7 is the PER-FRAME DISPATCH LIST (gpu.c copies count +
; 8 room entries there each kick) — it is NOT free scratch. A relocation
; onto it broke multi-room dispatch (2026-07-20). Real leftover scraps:
; !!! $F03F20 IS *NOT* FREE — it is SHADEK (see the .equ below), rewritten ONCE
; PER FACE whenever SHADEPASS=1. This line used to read "$F03F20 (4B,
; ex-SHADEK)" and that stale claim cost a silicon regression on 2026-07-24
; (matrix pointer parked there -> clobbered after room 1 -> scattered geometry).
; $F03F38-3F (8B), $F03EF0-FF (16B, PROFGPU=0
; builds only). Task 6 needs a 5-entry list + code diet to fit.
; chain A u/v DDA state
; AU/BU blocks moved into the tail freed by the 3-entry dispatch list
; (list ends $F03FA4; F03FA8-C7 free) -> code floor F03E40 -> F03E60,
; ceiling 3680.
AU		.equ	$F03FA8
AUSL		.equ	$F03FAC
AV		.equ	$F03FB0
AVSL		.equ	$F03FB4
; chain B u/v DDA state
BU		.equ	$F03FB8
BUSL		.equ	$F03FBC
BV		.equ	$F03FC0
BVSL		.equ	$F03FC4
; staged world packet + camera + iterator state
WBUF		.equ	$F03E60		; hdr + 4*3 world = 13 longs
CAM_BUF		.equ	$F03E98		; 7 longs
RVBASE		.equ	$F03EB4
QBASE		.equ	$F03EB8
TBASE		.equ	$F03EBC
QCNT		.equ	$F03EC0
TCNT		.equ	$F03EC4
OFFXW		.equ	$F03EC8
OFFZW		.equ	$F03ECC
FACE_LEFT	.equ	$F03ED0
FACE_CUR	.equ	$F03ED4
FACE_N		.equ	$F03ED8
RET_PHASE	.equ	$F03EE0
; per-poly cached affine gradient (du/dv identical on every scanline of an
; affine poly -> compute on the first wide span, reuse for the rest)
GRDF		.equ	$F03EE4		; 1 = GDU/GDV valid for this poly
GDU		.equ	$F03EE8
GDV		.equ	$F03EEC
NCULF		.equ	$F03F34		; per-packet no-cull flag (dispatch ptr
					; bit0; Lara's packet sets it)
; rect-shade accumulator (2026-07-20): the dispatch list shrank 8->5 entries
; (gpu.c/main.c), freeing $F03FC8-FF. Per face we accumulate the UNION rect
; of its spans and shade it in ONE multi-row blit at pkt_done instead of a
; blit per scanline — launch overhead was the silicon-real shade cost.
SH_Y0		.equ	$F03F38		; rect-shade: clipped y0 of the face
					; being rastered; -1 = disarmed (face
					; culled/empty -> no shade blit)
SHADEK		.equ	$F03F20		; per-face shade-k byte pattern (SHADEPASS;
					; 0 = full bright = skip the second blit)
ODP_PX		.equ	$F03EF4		; ODRAWS: accumulated span PIXELS (PROFGPU block)
ODP_N		.equ	$F03EF8		; ODRAWS: accumulated SPAN COUNT
RUNC		.equ	$F03F40		; scanline-run countdown (rows to next
					; chain event; chains checked per RUN)
; FARD ($F03F3C) RETIRED 2026-07-21: FARDIAL per-vert far cull measured NULL
; on silicon; its 14B funded the XCULL x SHADEPASS reconciliation. Slot free.
RUNHIST_BUF	.equ	$1C0000		; RUNHIST=1 probe only (emu telemetry):
					; 32-long DRAM histogram of run starts;
					; free gap between BSS end and stack
BEHINDF		.equ	$F03F48		; any-staged-vert-behind flag (per face)
VCACHE_PRM	.equ	$F03F08		; params[2] = vertex-cache DRAM base
RSAVE		.equ	$F03F4C		; r15 (byend) stash during span section
; PORTAL-WINDOW CLIP RECT (68k-written before each kick; full screen when
; unused). Spans clamp to [CLIPX0..CLIPX1], faces to [CLIPY0..CLIPY1].
; SINGLE-DISPATCH room list (params[7]): count, then per room
; {room_ptr, (clipx0<<16)|clipx1, (clipy0<<16)|clipy1}. One kick renders
; them all -> one 68k sync instead of one per room.
DISPCUR		.equ	$F03F60
DISPCNT		.equ	$F03F64
LISTMODE	.equ	$F03F68
VCDEF		.equ	$F03F6C		; params[2] default vertex-cache base
VCPTR		.equ	$F03F70		; this room's cache (0 = self-transform);
					; JERRY-filled caches carry a flag at -4
; LARACOUNT scratch: this face's plane d, stashed so the counters below can tell
; a RUNTIME BLOB (Lara/props, dummy d = $F8000000) from a room face.
; DRAM debug window beside CULLCOUNT's $1C0000/$1C0004 — diagnostic builds only.
LARAF		.equ	$001C0010
CLIPX0		.equ	$F03F50
CLIPX1		.equ	$F03F54
CLIPY0		.equ	$F03F58
CLIPY1		.equ	$F03F5C
; VC-timebase section profiling (halflines, ~31.8us each; 68k reads + clears)
TS0V		.equ	$F03EF0		; VC at section start
TACC_X		.equ	$F03EF4		; accumulated transform/setup halflines
TACC_R		.equ	$F03EF8		; accumulated raster (yloop) halflines
NSCAN		.equ	$F03EFC		; scanline (yloop iteration) counter
; STAGEDIET early backface cull: camera in ROOM-LOCAL units + validity flag.
; REUSES the PROFGPU block $F03EF0-FF — PROFGPU=1 + STAGEDIET=1 is FORBIDDEN
; (Makefile guards). Face records carry a 12B plane prefix (see extractor
; FACE_PLANES): {(ny<<16)|nx, nz, d}; cull iff N.C < d.
CAMLOC		.equ	$F03EF0		; cx,cy,cz,ok (ok!=0 -> keep-all room)
VC_REG		.equ	$F00006

	.gpu
	.org	$F03000

start:
	movei	#PARAMS,r1
	nop
	load	(r1),r4			; [0] room0_tex base ptr
	addq	#4,r1
	load	(r1),r30		; [1] mailbox
	addq	#4,r1
	; LISTMODE must be 0 BEFORE the self-test guard can jump to done: the
	; boot self-test reads it there UNINITIALIZED and a garbage value walked
	; the dispatch loop into a garbage room pointer (GPU bus-wedge at boot)
	movei	#LISTMODE,r0
	moveq	#0,r2
	store	r2,(r0)
	.if BANKDIET=1
	; ALTERNATE-BANK residents (BANKDIET, PACING step 4): the second
	; register file was 100% unused. Park the span loop's hot constants
	; there once per kick; the row path replaces 6-byte/2-cycle moveis
	; with 2-byte/1-cycle movefas. alt-r1=$FFFF0000 alt-r2=$FFFF
	; alt-r3=BLIT_GUARD.
	movei	#$FFFF0000,r0
	moveta	r0,r1
	shrq	#16,r0			; $0000FFFF
	moveta	r0,r2
	movei	#BLIT_GUARD,r0
	moveta	r0,r3
	movei	#sp_run,r0
	moveta	r0,r5			; alt-r5 = sp_run (hot loop-back target)
	movei	#imul32,r0
	moveta	r0,r12			; alt-r12 = imul32 (23 call sites)
	movei	#SY_BUF,r0
	moveta	r0,r10			; alt-r10 = SY_BUF (scan/chain hot)
	movei	#SX_BUF,r0
	moveta	r0,r11			; alt-r11 = SX_BUF
	.endif
	.if NOBLIT=0
	movei	#SH_Y0,r0		; same uninitialized-read hazard class
	subq	#1,r2
	store	r2,(r0)			; rect-shade disarmed (-1) until a
	addq	#1,r2			; face actually rasters
	.endif
	; --- self-test guard ---------------------------------------------------
	; gpu_init() self-tests EVERY kernel via gpu_spanfill(G_SRAM,0,..), which
	; passes params[0]=$F03000 (this GPU's own SRAM) as the "room".  That is
	; never a real room0_tex pointer (room data lives in ROM/DRAM), so parsing
	; it would read the kernel's own code as a garbage 16k-face header and
	; wedge the self-test -> gpu_ok=0 -> the real kick never fires -> black.
	; Detect the sentinel and round-trip immediately (r30 = mailbox is set).
	movei	#$F03000,r0
	cmp	r0,r4			; room - G_SRAM
	movei	#done,r22
	jump	EQ,(r22)		; room == $F03000 -> self-test, just report done
	nop
	; -----------------------------------------------------------------------
	; (waitstate benchmark DELETED - banked: ~1.3 cyc/instr)
bench_done:
	addq	#4,r1			; skip [2] unused -> at [3]
	load	(r1),r0			; [3] framebuffer base (8bpp)
	addq	#4,r1
	nop
	nop
	movei	#A2_BASE,r2		; A2_BASE = framebuffer (dest)
	store	r0,(r2)
	load	(r1),r7			; [4] camera-block ptr
	addq	#4,r1			; -> [5]
	nop
	nop
	; copy 7 camera longs into CAM_BUF (r7 = source cursor)
	movei	#CAM_BUF,r2
	moveq	#7,r3
cam_cpy:
	load	(r7),r8
	addq	#4,r7
	nop
	nop
	store	r8,(r2)
	addq	#4,r2
	subq	#1,r3
	movei	#cam_cpy,r22
	jump	NE,(r22)
	nop
	load	(r1),r8			; [5] atlas base
	addq	#4,r1			; -> [6]
	nop
	nop
	movei	#A1_BASE,r2		; A1_BASE = atlas (texture source)
	store	r8,(r2)
	load	(r1),r0			; [6] atlas_width
	nop
	nop

;---------------------------------------------------------------------
; Encode atlas_width (r0) into the A1 WID flag (gpu_bltex verbatim).
;   e = floor(log2 w); m = (w >> (e-2)) & 3; field = ((e<<2)|m) << 9.
;---------------------------------------------------------------------
	moveq	#1,r3			; const 1
	move	r0,r1			; t = w
	moveq	#0,r2			; e = 0
wid_e:
	cmp	r3,r1			; t - 1
	movei	#wid_e_done,r22
	jump	EQ,(r22)		; t == 1 -> e = floor(log2 w)
	nop
	jump	MI,(r22)		; t == 0 guard
	nop
	shrq	#1,r1
	movei	#wid_e,r22
	jump	T,(r22)
        addq	#1,r2
	nop
wid_e_done:
	move	r2,r8			; e
	subq	#2,r8			; e - 2
	move	r0,r9			; w
wid_m:
	cmpq	#0,r8
	movei	#wid_m_done,r22
	jump	EQ,(r22)
	nop
	jump	MI,(r22)		; guard e < 2
	nop
	shrq	#1,r9
	movei	#wid_m,r22
	jump	T,(r22)
        subq	#1,r8
	nop
wid_m_done:
	moveq	#3,r3
	and	r3,r9			; m = (w>>(e-2)) & 3
	shlq	#2,r2			; e << 2
	or	r9,r2			; (e<<2) | m
	shlq	#9,r2			; << 9 -> WID field (bits 9-14)
	movei	#A1_FIXED,r3		; PIXEL8 | XADDINC
	or	r3,r2			; A1_FLAGS = PIXEL8|WID|XADDINC
	movei	#A1_FLAGS,r1
	store	r2,(r1)
	movei	#A2_FLAGS_VAL,r2
	movei	#A2_FLAGS,r1
	store	r2,(r1)			; A2_FLAGS = PITCH1|PIXEL8|WID320|XADDPIX

;---------------------------------------------------------------------
; SINGLE-DISPATCH init: params[7] = room list (0 = legacy single room)
;---------------------------------------------------------------------
	movei	#PARAMS,r1
	movei	#28,r0
	add	r0,r1
	load	(r1),r0			; list ptr
	movei	#LISTMODE,r1
	moveq	#0,r2
	store	r2,(r1)			; default legacy
	movei	#VCPTR,r1
	store	r2,(r1)			; legacy: self-transform
	; stash the default cache base (params[2]) for self-transform rooms
	movei	#VCACHE_PRM,r1
	load	(r1),r2
	movei	#VCDEF,r1
	nop
	store	r2,(r1)
	cmpq	#0,r0
	movei	#hdr_parse,r22
	jump	EQ,(r22)		; no list -> legacy single-room path
	nop
	moveq	#1,r2
	movei	#LISTMODE,r1		; (r1 drifted to VCDEF via the stash inserts:
					;  storing 1 into VCDEF bus-wedged every
					;  list-mode kick -- reload the address!)
	store	r2,(r1)			; LISTMODE = 1
	load	(r0),r2			; count
	addq	#4,r0
	movei	#DISPCUR,r1
	store	r0,(r1)
	movei	#DISPCNT,r1
	store	r2,(r1)
room_next:
	movei	#DISPCNT,r1
	load	(r1),r2
	nop
	nop
	cmpq	#0,r2
	movei	#alldone,r22
	jump	EQ,(r22)		; list exhausted
	nop
	subq	#1,r2
	store	r2,(r1)
	movei	#DISPCUR,r1
	load	(r1),r0
	nop
	nop
	load	(r0),r4			; room ptr (bit0 = per-packet NO-CULL:
	addq	#4,r0			;   TR1 character meshes are double-sided)
	load	(r0),r2			; packed clip x
	addq	#4,r0
	load	(r0),r3			; packed clip y
	addq	#4,r0
	load	(r0),r21		; cache ptr (0 = self-transform)
	addq	#4,r0
	store	r0,(r1)			; advance cursor (r1 = DISPCUR)
	bclr	#0,r4			; blob ptr bit0 (ex NO-CULL flag) is
					; never set since the Lara winding fix;
					; plumbing removed 2026-07-20 for bytes
	movei	#VCPTR,r1
	store	r21,(r1)
	move	r2,r5
	shrq	#16,r5
	movei	#CLIPX0,r1
	store	r5,(r1)
	movei	#$FFFF,r5
	and	r5,r2
	movei	#CLIPX1,r1
	store	r2,(r1)
	move	r3,r5
	shrq	#16,r5
	movei	#CLIPY0,r1
	store	r5,(r1)
	movei	#$FFFF,r5
	and	r5,r3
	movei	#CLIPY1,r1
	store	r3,(r1)
hdr_parse:
;---------------------------------------------------------------------
; Parse the room0_tex 16-byte header (r4 = room base) into iterator state.
;   VERTS base = room+16 ; QUADS base = +vcount*8 ; TRIS base = +qcount*24.
;   offX/offZ are s16 (sign-extend) then <<8 (PACKED >>8 world units).
;---------------------------------------------------------------------
	move	r4,r6			; header cursor
	loadw	(r6),r5			; vcount @ +0
	addq	#2,r6
	loadw	(r6),r7			; qcount @ +2
	addq	#2,r6
	loadw	(r6),r8			; tcount @ +4
	addq	#6,r6			; skip atlasW(+6),atlasH(+8) -> +10
	loadw	(r6),r9			; offX @ +10 (s16)
	addq	#4,r6			; skip offY(+12) -> +14
	loadw	(r6),r10		; offZ @ +14 (s16)
	nop
	nop
	; VERTS base = room + 16
	move	r4,r0
	addq	#16,r0			; r0 = RVBASE
	; QUADS base = RVBASE + vcount*8
	move	r5,r1
	shlq	#3,r1			; vcount*8
	move	r0,r2
	add	r1,r2			; r2 = QBASE
	; TRIS base = QBASE + qcount*24 (36 with the STAGEDIET plane prefix)
.if STAGEDIET=1
	move	r7,r3
	shlq	#5,r3			; q*32
	move	r7,r12
	shlq	#2,r12			; q*4
.else
	move	r7,r3
	shlq	#4,r3			; q*16
	move	r7,r12
	shlq	#3,r12			; q*8
.endif
	add	r12,r3			; q*24 (or *36)
	move	r2,r13
	add	r3,r13			; r13 = TBASE
	; offX<<8 (sign-correct), offZ<<8
	shlq	#16,r9
	sharq	#16,r9			; sign-extend offX
	shlq	#8,r9			; offX<<8
	shlq	#16,r10
	sharq	#16,r10			; sign-extend offZ
	shlq	#8,r10			; offZ<<8
	; store iterator state
	movei	#RVBASE,r14
	store	r0,(r14)
	movei	#QBASE,r14
	store	r2,(r14)
	movei	#TBASE,r14
	store	r13,(r14)
	movei	#QCNT,r14
	store	r7,(r14)
	movei	#TCNT,r14
	store	r8,(r14)
	movei	#OFFXW,r14
	store	r9,(r14)
	movei	#OFFZW,r14
	store	r10,(r14)
.if STAGEDIET=1
	; CAMLOC = camera in ROOM-LOCAL units (r9/r10 still hold offX/offZ<<8
	; = full-unit room origin; rooms have offY=0 so cy = camy). ok!=0 when
	; any component exceeds s16 — imult in the face test would wrap, so
	; such rooms skip the early cull entirely (keep-all, still correct).
	movei	#CAM_BUF+16,r14
	load	(r14),r0		; camx (world units)
	load	(r14+1),r1		; camy
	load	(r14+2),r2		; camz
	sub	r9,r0			; cx
	sub	r10,r2			; cz
	move	r0,r3
	abs	r3
	move	r1,r11
	abs	r11
	or	r11,r3
	move	r2,r11
	abs	r11
	or	r11,r3
	shrq	#15,r3			; !=0 iff any |c| >= 32768
	movei	#CAMLOC,r14
	store	r0,(r14)
	store	r1,(r14+1)
	store	r2,(r14+2)
	store	r3,(r14+3)
.endif

	; mailbox[1] = hello
	movei	#MAGIC_HELLO,r0
	move	r30,r1
	addq	#4,r1
	store	r0,(r1)

	; ============ PER-ROOM VERTEX TRANSFORM CACHE (pre-pass) ============
	; JERRY CO-TRANSFORM gate: VCPTR != 0 -> Jerry owns this room's cache.
	; Poll its done-flag (cacheptr-4 == 2) with a bounded guard; on success
	; point VCACHE_PRM at Jerry's cache and SKIP the whole pre-pass. Guard
	; exhausted -> fall through to self-transform (never hangs, only slows).
	movei	#VCPTR,r0
	load	(r0),r18
	nop
	nop
	cmpq	#0,r18
	movei	#vc_self,r22
	jump	EQ,(r22)		; self-transform room
	nop
	move	r18,r1
	subq	#4,r1			; flag address
	movei	#5000,r2		; poll guard: ~3ms cap — self-transform
					; costs about that, so never wait longer
					; (2M guard pinned Tom for 100s of ms at
					; full-level scale while STARVING Jerry)
vc_jwait:
	load	(r1),r0
	; register-free backoff (r3 was NOT free here — the counter loop
	; clobbered live state -> stale-looking geometry on polled rooms)
	nop
	nop
	nop
	nop
	nop
	nop
	nop
	nop
	subq	#1,r2
	cmpq	#2,r0
	jr	EQ,vc_jok		; Jerry done -> use his cache
	nop
	cmpq	#0,r2
	jr	NE,vc_jwait
	nop
	movei	#vc_self,r22		; guard exhausted -> self-transform
	jump	T,(r22)
	nop
vc_jok:
	movei	#VCACHE_PRM,r0
	store	r18,(r0)		; faces read Jerry's cache
	movei	#vc_done,r22
	jump	T,(r22)			; skip the whole pre-pass
	nop
vc_self:
	movei	#VCDEF,r0
	load	(r0),r18
	movei	#VCACHE_PRM,r1
	nop
	store	r18,(r1)		; faces read the default cache
	movei	#VCACHE_PRM,r0
	load	(r0),r18		; cache write ptr
	movei	#CAM_BUF,r0
	load	(r0),r11		; cY4
	addq	#4,r0
	load	(r0),r12		; sY4
	addq	#4,r0
	load	(r0),r13		; cP4
	addq	#4,r0
	load	(r0),r14		; sP4
	addq	#4,r0
	load	(r0),r15		; camx
	addq	#4,r0
	load	(r0),r16		; camy
	addq	#4,r0
	load	(r0),r17		; camz
	.if OFFHOIST=1
	; hoist the per-room offsets out of vc_loop: dx = wx-camx = x-(camx-offX),
	; so fold once into r26/r27 here (freed by INLINEMUL — REQUIRED: without
	; it imul32 clobbers both every call) and drop 2 movei + 2 SRAM loads +
	; 2 adds + a nop from EVERY vertex.
	movei	#OFFXW,r1
	load	(r1),r26
	movei	#OFFZW,r1
	load	(r1),r27
	nop
	neg	r26
	neg	r27
	add	r15,r26			; camx - offX
	add	r17,r27			; camz - offZ
	.endif
	.if MMULTX
	; --- MMULT rotate setup: copy the 9 precomposed Q12 coeffs into MTXBUF
	;     (= WBUF, verified free during the pre-pass — the face loop clobbers it
	;     but every room re-enters vc_self and re-copies). MTXC = 3 (by-row).
	;     Each coeff is in both 16-bit halves so MMULT's low-16 SRAM fetch reads
	;     it. r0-r4,r22 free here (r4 = room base is dead after hdr_parse).
	;     The matrix is APPENDED TO THE CAMERA BLOCK at +28, read via PARAMS[4]
	;     ($F03F10) — the 68k rewrites that every kick and the kernel never
	;     writes PARAMS. DO NOT park this pointer in $F03F20: that is SHADEK,
	;     which SHADEPASS rewrites once per face, so room 2+ (and Lara) would
	;     copy a shade byte pattern as their matrix. That was the 2026-07-24
	;     scattered-Lara regression. ---
	movei	#$F03F10,r0		; PARAMS[4] = camera block DRAM ptr
	load	(r0),r1
	nop
	nop
	addq	#28,r1			; -> the 9 appended matrix longs
	movei	#WBUF,r2		; MTXBUF dest in GPU SRAM
	moveq	#9,r3			; 9 longs
	movei	#mmx_copy,r22
mmx_copy:
	load	(r1),r4
	addq	#4,r1
	nop
	store	r4,(r2)
	addq	#4,r2
	subq	#1,r3
	jump	NE,(r22)
	nop
	movei	#$F02104,r0		; G_MTXC
	moveq	#3,r1
	store	r1,(r0)			; MWIDTH = 3, by-row (bit4 MATCOL = 0)
	.endif
	movei	#G_DIVCTRL,r0
	moveq	#0,r1
	store	r1,(r0)			; integer divide mode (projection)
	movei	#RVBASE,r0
	load	(r0),r10		; vert cursor
	move	r5,r31			; vert counter (r5 = vcount, still live)
	cmpq	#0,r31
	movei	#vc_done,r22
	jump	EQ,(r22)
	nop
	.if VCJDIET=1
	movei	#vc_loop,r28		; loop-back target hoisted (r28 freed by
					; INLINEMUL — REQUIRED: the imul32 ladder
					; uses r28 as its return register)
	.endif
vc_loop:
	.if VPACK=1
	; two long loads instead of three word loads: RVert is (x,y,z,shade)
	; s16 big-endian at stride 8, so long@+0 = (x<<16)|y and long@+4 =
	; (z<<16)|shade — one fewer DRAM access per vertex (ext mem is the
	; dominant stall bucket, 41% of room 34 after INLINEMUL)
	load	(r10),r8		; (x<<16)|y
	addq	#4,r10
	load	(r10),r20		; (z<<16)|shade
	addq	#4,r10
	move	r8,r9
	sharq	#16,r8			; x (arithmetic >> sign-extends)
	shlq	#16,r9
	sharq	#16,r9			; y
	sharq	#16,r20			; z (shade falls off the bottom)
	.else
	loadw	(r10),r8		; x
	addq	#2,r10
	loadw	(r10),r9		; y
	addq	#2,r10
	loadw	(r10),r20		; z
	addq	#4,r10			; +4 -> next RVert (z@+4, stride 8)
	shlq	#16,r8
	sharq	#16,r8
	shlq	#16,r9
	sharq	#16,r9
	shlq	#16,r20
	sharq	#16,r20
	.endif
	.if OFFHOIST=1
	sub	r26,r8			; dx = x - (camx-offX)
	sub	r16,r9			; dy
	sub	r27,r20			; dz = z - (camz-offZ)
	.else
	movei	#OFFXW,r0
	load	(r0),r1
	movei	#OFFZW,r0
	load	(r0),r2
	nop
	add	r1,r8			; wx
	add	r2,r20			; wz
	sub	r15,r8			; dx
	sub	r16,r9			; dy
	sub	r17,r20			; dz
	.endif
	.if MMXDIAG
	; TEMP DIAGNOSTIC: OR |dx|,|dy|,|dz| into $1C0010. Any bit >=15 set in the
	; result means some component exceeded s16 -> the bank-1 pack truncates it
	; (the documented MMULT range risk). Read with jagemu peek.
	movei	#$001C0010,r2
	load	(r2),r3
	move	r8,r0
	abs	r0
	or	r0,r3
	move	r9,r0
	abs	r0
	or	r0,r3
	move	r20,r0
	abs	r0
	or	r0,r3
	store	r3,(r2)
	.endif
	.if MMULTX
	; --- MMULT rotate: (rx,ry,rz2) = R*(dx,dy,dz) via 3 hardware MMULTs against
	;     the precomposed 3x3 in MTXBUF, replacing the 8 imul32 (vcf1..8). Pack
	;     the vector into consecutive bank-1 regs r0/r1 (r0 = dx|(dy<<16),
	;     r1 = dz); re-moveta before EACH mmult (silicon reads the operand through
	;     the moveta, not the file); re-store MTXA per row (auto-advance proven on
	;     silicon but not relied on yet). MTXC=3 was set at pre-pass start. ---
	move	r8,r0			; dx
	shlq	#16,r0
	shrq	#16,r0			; dx & 0xFFFF (clear high)
	move	r9,r1			; dy
	shlq	#16,r1			; dy << 16
	or	r1,r0			; r0 = (dy<<16)|(dx&FFFF)  [elem0=dx, elem1=dy]
	move	r20,r1			; r1 = dz                  [elem2 = low(r1)]
	; DRAIN DISCIPLINE (2026-07-24 silicon regression): the first cut chained the
	; 3 MMULTs with only ~4 instructions between them and 6 nops before reading —
	; it rendered CORRECTLY in jagemu (which models MMULT as instantaneous) but
	; produced SCATTERED/garbage vertices on real Tom. cobweb's silicon-validated
	; p_mmult settles 8 nops after every mmult before its result is touched and
	; never lets two mmults run close together. Match that exactly; the systolic
	; result lands late and a too-short settle lets a later access catch it.
	movei	#$F02108,r2		; G_MTXA
	movei	#WBUF,r3
	store	r3,(r2)			; MTXA -> row0
	moveta	r0,r0			; vector -> bank1 (REQUIRED immediately pre-mmult)
	moveta	r1,r1
	mmult	r0,r21			; r21 = row0 . vec  (rx, Q12)
	.rept	8
	nop				; settle row0 (validated spacing)
	.endr
	movei	#WBUF+12,r3
	store	r3,(r2)			; MTXA -> row1
	moveta	r0,r0
	moveta	r1,r1
	mmult	r0,r24			; r24 = row1 . vec  (ry, Q12)
	.rept	8
	nop				; settle row1
	.endr
	movei	#WBUF+24,r3
	store	r3,(r2)			; MTXA -> row2
	moveta	r0,r0
	moveta	r1,r1
	mmult	r0,r25			; r25 = row2 . vec  (rz2, Q12)
	.rept	8
	nop				; settle row2 before the sharq reads it
	.endr
	sharq	#12,r21			; rx
	sharq	#12,r24			; ry
	sharq	#12,r25			; rz2
	.else
	.if INLINEMUL=1
	; INLINEMUL (2026-08-06): every rotate operand is s16 on silicon
	; (MMXDIAG cap $7FFF; coeffs Q12 <= 4096), so one signed 16x16 imult
	; is exact where imul32 did a full 32x32 — the 8 call/returns
	; (16 taken jumps = pipeline refills each vertex) collapse to 8
	; inline imults, interleaved so no product is read within 2 instrs.
	move	r8,r21			; dx
	imult	r11,r21			; dx*cY
	move	r20,r0			; dz
	imult	r12,r0			; dz*sY
	move	r8,r23			; dx
	imult	r12,r23			; dx*sY
	sub	r0,r21			; rx = dx*cY - dz*sY
	move	r20,r0			; dz
	imult	r11,r0			; dz*cY
	sharq	#12,r21			; rx
	move	r9,r24			; dy
	imult	r13,r24			; dy*cP
	add	r0,r23			; rzt = dx*sY + dz*cY
	sharq	#12,r23
	move	r23,r0
	imult	r14,r0			; rzt*sP
	move	r9,r25			; dy
	imult	r14,r25			; dy*sP
	sub	r0,r24			; ry = dy*cP - rzt*sP
	move	r23,r0
	imult	r13,r0			; rzt*cP
	sharq	#12,r24			; ry
	nop
	add	r0,r25			; rz2 = dy*sP + rzt*cP
	sharq	#12,r25
	.else
	move	r8,r0
	movei	#vcf1,r28
	.if BANKDIET=1
	movefa	r12,r22			; imul32 (bank-1 resident)
	.else
	movei	#imul32,r22
	.endif
	jump	T,(r22)
        move	r11,r1
	nop
vcf1:
	move	r0,r21
	move	r20,r0
	movei	#vcf2,r28
	.if BANKDIET=1
	movefa	r12,r22			; imul32 (bank-1 resident)
	.else
	movei	#imul32,r22
	.endif
	jump	T,(r22)
        move	r12,r1
	nop
vcf2:
	sub	r0,r21
	sharq	#12,r21			; rx
	move	r8,r0
	movei	#vcf3,r28
	.if BANKDIET=1
	movefa	r12,r22			; imul32 (bank-1 resident)
	.else
	movei	#imul32,r22
	.endif
	jump	T,(r22)
        move	r12,r1
	nop
vcf3:
	move	r0,r23
	move	r20,r0
	movei	#vcf4,r28
	.if BANKDIET=1
	movefa	r12,r22			; imul32 (bank-1 resident)
	.else
	movei	#imul32,r22
	.endif
	jump	T,(r22)
        move	r11,r1
	nop
vcf4:
	add	r0,r23
	sharq	#12,r23			; rz
	move	r9,r0
	movei	#vcf5,r28
	.if BANKDIET=1
	movefa	r12,r22			; imul32 (bank-1 resident)
	.else
	movei	#imul32,r22
	.endif
	jump	T,(r22)
        move	r13,r1
	nop
vcf5:
	move	r0,r24
	move	r23,r0
	movei	#vcf6,r28
	.if BANKDIET=1
	movefa	r12,r22			; imul32 (bank-1 resident)
	.else
	movei	#imul32,r22
	.endif
	jump	T,(r22)
        move	r14,r1
	nop
vcf6:
	sub	r0,r24
	sharq	#12,r24			; ry
	move	r9,r0
	movei	#vcf7,r28
	.if BANKDIET=1
	movefa	r12,r22			; imul32 (bank-1 resident)
	.else
	movei	#imul32,r22
	.endif
	jump	T,(r22)
        move	r14,r1
	nop
vcf7:
	move	r0,r25
	move	r23,r0
	movei	#vcf8,r28
	.if BANKDIET=1
	movefa	r12,r22			; imul32 (bank-1 resident)
	.else
	movei	#imul32,r22
	.endif
	jump	T,(r22)
        move	r13,r1
	nop
vcf8:
	add	r0,r25
	sharq	#12,r25			; rz2
	.endif
	.endif
	; NEAR-SNAP REVERTED (task 19 postponed): every clamp variant drew
	; wrong-but-on-screen geometry (ceiling flashes / smear plates /
	; stretch, all HW-seen 2026-07-11). Pop-in (clean cull) is the
	; lesser artifact. Real fix = true edge clipping; needs kernel bytes.
	movei	#NEAR,r0
	cmp	r0,r25
	movei	#vc_behind,r22
	jump	MI,(r22)
	nop
	; (FARDIAL per-vert far cull lived here 2026-07-21 only: measured NULL
	; on silicon, removed same day for the XCULL x SHADEPASS byte budget.)
	.if INLINEMUL=1
	movei	#FOCAL,r1		; FOCAL=190 s16, rx s16 -> imult exact
	move	r21,r0
	imult	r1,r0
	nop
	nop
	.else
	movei	#FOCAL,r1
	movei	#vcf9,r28
	.if BANKDIET=1
	movefa	r12,r22			; imul32 (bank-1 resident)
	.else
	movei	#imul32,r22
	.endif
	jump	T,(r22)
        move	r21,r0
	nop
vcf9:
	.endif
	move	r0,r29
	abs	r0
	div	r25,r0
	cmpq	#0,r29
	jr	PL,vc_sxp
	nop
	neg	r0
vc_sxp:
	movei	#CENTER_X,r1
	add	r1,r0
	store	r0,(r18)		; cache sx
	.if INLINEMUL=1
	movei	#FOCAL_Y,r1		; FOCAL_Y<=190 s16, ry s16 -> imult exact
	move	r24,r0
	imult	r1,r0
	nop
	nop
	.else
	movei	#FOCAL_Y,r1
	movei	#vcf10,r28
	.if BANKDIET=1
	movefa	r12,r22			; imul32 (bank-1 resident)
	.else
	movei	#imul32,r22
	.endif
	jump	T,(r22)
        move	r24,r0
	nop
vcf10:
	.endif
	move	r0,r29
	abs	r0
	div	r25,r0
	cmpq	#0,r29
	jr	PL,vc_syp
	nop
	neg	r0
vc_syp:
	movei	#CENTER_Y,r1
	add	r1,r0
	addq	#4,r18
	store	r0,(r18)		; cache sy
	addq	#4,r18
	store	r25,(r18)		; cache rz2 (view depth, for near clip)
	.if VCJDIET=1
	; common path FALLS THROUGH to vc_next (the behind block moves past the
	; loop exit) and the loop-back reuses hoisted r28 — saves a movei+jump
	; on the sy path and a movei on every iteration
	addq	#4,r18
vc_next:
	subq	#1,r31
	jump	NE,(r28)		; r28 = vc_loop (hoisted in vc_self)
	nop
	movei	#vc_done,r22		; loop exhausted -> skip the behind block
	jump	T,(r22)
	nop
vc_behind:
	movei	#$07FFFFFF,r0
	store	r0,(r18)		; behind sentinel
	addq	#12,r18
	movei	#vc_next,r22		; rare path pays the jump instead
	jump	T,(r22)
	nop
	.else
	movei	#vc_next,r22
	jump	T,(r22)
        addq	#4,r18
	nop
vc_behind:
	movei	#$07FFFFFF,r0
	store	r0,(r18)		; behind sentinel
	addq	#12,r18
vc_next:
	subq	#1,r31
	movei	#vc_loop,r22
	jump	NE,(r22)
	nop
	.endif
vc_done:
	; fall into quad_setup

;=====================================================================
; PHASE SETUP: quads (n=4) then tris (n=3).  Each sets FACE_LEFT / FACE_CUR /
; FACE_N and RET_PHASE (where to go when this phase's faces are exhausted),
; then enters the unified face_loop.
;=====================================================================
quad_setup:
	movei	#QCNT,r0
	load	(r0),r8			; quad count
	movei	#QBASE,r0
	load	(r0),r9			; quad base
	nop
	nop
	movei	#FACE_LEFT,r0
	store	r8,(r0)
	movei	#FACE_CUR,r0
	store	r9,(r0)
	moveq	#4,r8
	movei	#FACE_N,r0
	store	r8,(r0)			; n = 4
	movei	#tri_setup,r8
	movei	#RET_PHASE,r0
	store	r8,(r0)			; quads done -> tri_setup
	movei	#face_loop,r22
	jump	T,(r22)
	nop

tri_setup:
	movei	#TCNT,r0
	load	(r0),r8			; tri count
	movei	#TBASE,r0
	load	(r0),r9			; tri base
	nop
	nop
	movei	#FACE_LEFT,r0
	store	r8,(r0)
	movei	#FACE_CUR,r0
	store	r9,(r0)
	moveq	#3,r8
	movei	#FACE_N,r0
	store	r8,(r0)			; n = 3
	movei	#done,r8
	movei	#RET_PHASE,r0
	store	r8,(r0)			; tris done -> done
	movei	#face_loop,r22
	jump	T,(r22)
	nop

;=====================================================================
; face_loop: stage ONE face (world verts -> WBUF, UVs -> U_BUF/V_BUF) then
; hand it to render_pkt.  render_pkt returns to face_loop via pkt_done.
;=====================================================================
face_loop:
	.if PREPASSONLY=1
	; PROBE: skip the entire face loop -> GPU time = vertex pre-pass only.
	; ALLCULL - PREPASSONLY = the per-face-loop setup cost (what cluster-
	; cull can recover); PREPASSONLY = the O(vcount) pre-pass (LOD-only).
	movei	#alldone,r22
	jump	T,(r22)
	nop
	.endif
	; --- section profile: TACC_S += (VC now) - TS0V is handled at render_pkt;
	; here we just stamp TS0V so [face fetch + stage_vert DRAM staging] is
	; the section closed by render_pkt's existing TACC accounting. ---
	.if PROFGPU=1
	movei	#VC_REG,r0
	loadw	(r0),r1
	movei	#TS0V,r0
	nop
	store	r1,(r0)
	.endif
	movei	#FACE_LEFT,r0
	load	(r0),r5
	nop
	nop
	cmpq	#0,r5
	movei	#fl_go,r22
	jump	NE,(r22)		; faces remain -> process
	nop
	; phase exhausted -> jump RET_PHASE (tri_setup or done)
	movei	#RET_PHASE,r0
	load	(r0),r1
	nop
	nop
	jump	T,(r1)
	nop
fl_go:
	; geometry constants for stage_vert
	movei	#RVBASE,r0
	load	(r0),r10		; VERTS base
	movei	#OFFXW,r0
	load	(r0),r11		; offX<<8
	movei	#OFFZW,r0
	load	(r0),r13		; offZ<<8
	moveq	#0,r12			; yTopD = 0 (offY=0)
	movei	#FACE_N,r0
	load	(r0),r21		; n
	movei	#FACE_CUR,r0
	load	(r0),r20		; face record ptr
	nop
	nop
.if STAGEDIET=1
	; EARLY BACKFACE CULL: 12B plane prefix {(ny<<16)|nx, nz, d} on every
	; record; cull iff N.C < d, C = CAMLOC (room-local, |c|<=s16 or the
	; ok flag keeps everything). Runtime blobs (Lara/props/title) carry
	; dummy planes {0,0,INT32_MIN} = never culled by this test.
	movei	#CAMLOC,r14
	load	(r20),r1		; (ny<<16)|nx
	addq	#4,r20
	load	(r20),r2		; nz
	addq	#4,r20
	load	(r20),r3		; d
	addq	#4,r20			; r20 -> vertex indices (BOTH paths)
.if LARACOUNT=1
	movei	#LARAF,r4		; (movei + 2 nops = r3's load has landed)
	nop
	nop
	store	r3,(r4)
.endif
	load	(r14+3),r0		; ok flag
	load	(r14),r5		; cx
	cmpq	#0,r0
	movei	#sd_keep,r22
	jump	NE,(r22)		; camera out of s16 range -> stage all
	move	r1,r4			; slot: dup plane long0 (benign)
	imult	r5,r4			; nx*cx (both s16 in low word)
	load	(r14+1),r5		; cy
	sharq	#16,r1			; ny
	load	(r14+2),r0		; cz
	imult	r5,r1			; ny*cy
	imult	r0,r2			; nz*cz
	add	r4,r1
	nop
	add	r2,r1			; N.C
	cmp	r3,r1			; N.C - d
	movei	#sd_keep,r22
.if NOSDCULL=1
	; DIAGNOSTIC (2026-07-30): skip the WORLD-space plane cull entirely -
	; always keep. This is the FIRST cull in the chain and the only one never
	; tested on hardware for the flashing-face artifact. It compares N.C
	; against d using a 7-BIT QUANTISED normal plus a SLACK margin, so a face
	; that is nearly edge-on sits right on the boundary and sub-unit camera
	; drift (Lara's idle animation) can tip it either way between frames -
	; exactly the observed symptom. Replacing the jump with a nop keeps the
	; instruction count identical, so the image layout does not move.
	nop
.else
.if SDPROBE=1
	; POSITIVE CONTROL (2026-07-29): never take the keep branch, so EVERY
	; face must fall through to the cull path. staged must collapse to ~0.
	; If staged is unchanged, this cull is not reached at all -- which is
	; the only remaining explanation for it being insensitive to the plane
	; data (SLACK=0 and TIGHT both changed mrt_geom.bin and changed nothing).
	nop
.else
	jump	PL,(r22)		; front-facing -> stage normally
.endif
.endif
	nop
	; fallthrough = backface: advance cursor/count, back to face_loop
	.if WCCNT=1
	; n_worldcull++ ($1C0014). The LAST piece of attribution: with this,
	; every stage is derivable per interval --
	;   total faces      = worldcull + staged
	;   near-plane       = bexit
	;   screen-space     = staged - bexit - rastered   (area + XCULL + empty-y)
	;   drawn            = rastered
	; so whichever bucket swings in step with the flashing names the stage,
	; instead of eliminating one cull per flash. r0/r1 are dead here (r1 is
	; reloaded with face_adv immediately below).
	movei	#$001C0014,r0
	load	(r0),r1
	nop
	nop
	addq	#1,r1
	store	r1,(r0)
	.endif
	movei	#face_loop,r22
	movei	#face_adv,r1
	jump	T,(r1)
	nop
sd_keep:
.endif
	; header (n<<16) -> WBUF ; r14 = WBUF+4 (world write ptr)
	move	r21,r0
	shlq	#16,r0
	movei	#WBUF,r14
	store	r0,(r14)
	addq	#4,r14
	; uvbase = rec + 2*n  (start of the UV block) -> r7 (stage_vert preserves it)
	move	r21,r7
	shlq	#1,r7
	add	r20,r7
	.if SHADEPASS=1
	; per-face shade k rides in u[0] bits 13-15 (extractor RAMP_PAL packing;
	; u < 8192 so the bits are free). Build the replicated byte pattern
	; once per face into SHADEK; 0 = full bright = sp_fill skips the pass.
	; (u[0] now carries corner-0's VERTEX k — a fine per-face proxy.)
	loadw	(r7),r0
	movei	#SHADEK,r2
	shrq	#13,r0			; k (0..7)
	move	r0,r1
	shlq	#8,r1
	or	r1,r0			; k | k<<8
	move	r0,r1
	shlq	#16,r1
	or	r1,r0			; k in all 4 bytes
	.if NOBLIT=1
	moveq	#0,r0			; BISECT: force k=0 -> launcher never fires
	.endif
	store	r0,(r2)
	.endif
.if BEXIT=0
	movei	#BEHINDF,r0
	moveq	#0,r1
	store	r1,(r0)			; no behind verts staged yet
.endif
	moveq	#0,r6			; j = 0
stage_loop:
	cmp	r21,r6			; j - n
	movei	#stage_done,r22
	jump	EQ,(r22)
	nop
	; idx = loadw(rec + 2*j)
	move	r6,r0
	shlq	#1,r0
	add	r20,r0
	loadw	(r0),r1			; vertex index (u16)
	; stage_vert(index r1) -> 3 world longs at r14, r14+=12
	movei	#sv_ret,r8
	movei	#stage_vert,r22
	jump	T,(r22)
	nop
sv_ret:
	or	r1,r1			; consume the idx load for the hazard
					; checker (stage_vert already did; jas
					; cannot see through the indirect call)
	; per-vertex (u,v) = loadw(uvbase + 4*j) - passed straight through, untransformed
	move	r6,r0
	shlq	#2,r0
	add	r7,r0			; &u[j]
	loadw	(r0),r2			; u (bits 13-15 = this corner's vertex k)
	addq	#2,r0
	loadw	(r0),r3			; v (int atlas texel row)
	move	r6,r1
	shlq	#2,r1			; j*4
	.if SHADEPASS=1
	shlq	#19,r2			; strip the per-corner k bits from u
	shrq	#19,r2
	.endif
	movei	#U_BUF,r0
	add	r1,r0
	store	r2,(r0)			; U_BUF[j] = u
	movei	#V_BUF,r0
	add	r1,r0
	store	r3,(r0)			; V_BUF[j] = v
	movei	#stage_loop,r22
	jump	T,(r22)
        addq	#1,r6
	nop
stage_done:
	movei	#render_pkt,r22		; face_adv exits through (r22)
face_adv:
	; FACE_CUR += record size (6n, +12 plane under STAGEDIET); FACE_LEFT--
	; then jump (r22): render_pkt (staged) or face_loop (early-culled).
	movei	#FACE_CUR,r0
	load	(r0),r1
	move	r21,r2
	shlq	#2,r2			; 4n
	move	r21,r3
	shlq	#1,r3			; 2n
	add	r3,r2			; 6n
.if STAGEDIET=1
	addq	#12,r2			; + plane prefix
.endif
	add	r2,r1			; FACE_CUR + record size
	store	r1,(r0)
	movei	#FACE_LEFT,r0
	load	(r0),r1
	movei	#WBUF,r4		; render_pkt arg (benign on skip path)
	subq	#1,r1
	store	r1,(r0)
	jump	T,(r22)
	nop

;=====================================================================
; render_pkt : gpu_geomdirect per-polygon TRANSFORM+PROJECT+CULL front-end,
;   VERBATIM, spliced to the gpu_bltex TEXTURED edge-walk.
;   in:  r4 = WBUF ([0]=(n<<16), then n*3 s32 world coords), r30 = mailbox,
;        CAM_BUF holds camera, U_BUF/V_BUF hold this face's per-vertex (u,v).
;   completion / any skip -> pkt_done -> face_loop.
;=====================================================================
render_pkt:
	.if LARACOUNT=1
	; HER staged -> $1C0008, RUNTIME BLOBS ONLY (dummy plane d = $F8000000).
	; (staged - rastered) for her = faces killed by the screen-space guards.
	movei	#LARAF,r0
	load	(r0),r1
	nop
	nop
	movei	#$F8000000,r0
	cmp	r0,r1
	movei	#lc_s_no,r22
	jump	NE,(r22)
	nop
	movei	#$001C0008,r0
	load	(r0),r1
	nop
	nop
	addq	#1,r1
	store	r1,(r0)
lc_s_no:
	.endif
	.if CULLCOUNT=1
	; n_staged++ : a face reaching here passed the N.C world backface cull
	; and is being fully transformed+screen-tested (the "staged" cost).
	; r0 free at entry (header load overwrites it next). $1C0000 DRAM.
	movei	#$001C0000,r0
	load	(r0),r1
	nop
	nop
	addq	#1,r1
	store	r1,(r0)
	.endif
	; --- section profile: close STAGING section (face fetch + stage_vert
	; DRAM reads) into GDV, then stamp TS0V for the TRANSFORM section ---
	.if PROFGPU=1
	movei	#VC_REG,r1
	loadw	(r1),r0
	movei	#TS0V,r1
	nop
	load	(r1),r2
	movei	#GDV,r22
	nop
	sub	r2,r0
	cmpq	#0,r0
	jr	PL,vcs_ok
	nop
	movei	#525,r2
	add	r2,r0
vcs_ok:
	load	(r22),r1
	nop
	nop
	add	r0,r1
	store	r1,(r22)		; TACC_S += staging delta
	movei	#VC_REG,r1
	loadw	(r1),r0
	movei	#TS0V,r1
	nop
	store	r0,(r1)			; transform section starts
	.endif
	; header = (n<<16) | color-slot (color unused for textured fill)
	load	(r4),r0
	addq	#4,r4
	nop
	nop
	move	r0,r6
	shrq	#16,r6			; r6 = n
	movei	#$FFFF,r1
	and	r1,r0			; low 16 (ignored)
	move	r0,r7
	shlq	#16,r7
	or	r0,r7			; r7 = replicated low16 (unused by textured span)

	; VERTEX CACHE: SX/SY filled during staging; transform vloop GONE.
.if BEXIT=0
	movei	#BEHINDF,r0
	load	(r0),r19
	nop
	nop
	cmpq	#0,r19
.if NEARCLIP=1
	; ---- NEAR-PLANE EDGE CLIP (hoisted to the FACE loop) ----------------
	; A face with a vertex behind NEAR used to be thrown away whole - the
	; R4 rock that blinks.  Clip the crossing edge to z = NEAR instead.
	; HOISTED HERE, not into stage_vert, because in the face phase r14 is
	; re-established per face (movei #WBUF,r14) and the alt bank can park
	; what must survive in ONE instruction each, where stage_vert would
	; have to spill r10-r14 to SRAM around every vertex.
	; Handles exactly ONE behind vertex - the single-corner case, which is
	; what a floor slab under the camera does.  Two or more still drop the
	; face, as today.
	movei	#nc_try,r22
	jump	NE,(r22)
	nop
nc_back:
.else
	; any vertex behind -> skip whole poly
	movei	#pkt_done,r22
	jump	NE,(r22)
	nop
.endif
.endif
	; (BEXIT=1: stage_vert aborts the face at the FIRST behind-sentinel
	; vert — no face with a behind vert ever reaches render_pkt, so the
	; BEHINDF flag and this check are compiled out entirely.)

	; ---- backface cull: ar = (sx1-sx0)*(sy2-sy0)-(sx2-sx0)*(sy1-sy0) ----
	.if BANKDIET=1
	movefa	r11,r0			; SX_BUF (bank-1)
	.else
	movei	#SX_BUF,r0
	.endif
	load	(r0),r8			; sx0
	addq	#4,r0
	load	(r0),r9			; sx1
	addq	#4,r0
	load	(r0),r20		; sx2
	.if BANKDIET=1
	movefa	r10,r0			; SY_BUF (bank-1)
	.else
	movei	#SY_BUF,r0
	.endif
	load	(r0),r21		; sy0
	addq	#4,r0
	load	(r0),r23		; sy1
	addq	#4,r0
	load	(r0),r24		; sy2
.if XCULL=1
	; FACE X-CULL (BUCKET guard 1): a face whose verts are ALL left or ALL
	; right of the clip window still walks its whole y-range paying full
	; per-row edge/uv/clamp cost for spans that clamp empty (up to 240
	; rows). Reject it here, pixel-exact: the 2px margin absorbs edge-DDA
	; truncation jitter. For tris SX_BUF[3] is stale — a stale term can
	; only make the all-outside AND/OR test MORE conservative, never wrong.
	.if BANKDIET=1
	movefa	r11,r14			; SX_BUF (bank-1)
	.else
	movei	#SX_BUF,r14
	.endif
	load	(r14+3),r1		; sx3 (stale for tris: conservative)
	movei	#CLIPX0,r14
	load	(r14),r2		; clipx0
	load	(r14+1),r3		; clipx1
	subq	#1,r2			; L: sx-L<0 for all <=> all sx<=clipx0-2
	move	r8,r0
	sub	r2,r0			; sx0-L
	move	r9,r14
	sub	r2,r14
	and	r14,r0
	move	r20,r14
	sub	r2,r14
	and	r14,r0
	move	r1,r14
	sub	r2,r14
	and	r14,r0			; sign set iff ALL four left of window
	movei	#pkt_done,r22
	cmpq	#0,r0
	jump	MI,(r22)		; whole face left of clip -> skip
	addq	#2,r3			; slot: R = clipx1+2 (harmless if taken)
	move	r8,r0
	sub	r3,r0
	move	r9,r14
	sub	r3,r14
	or	r14,r0
	move	r20,r14
	sub	r3,r14
	or	r14,r0
	move	r1,r14
	sub	r3,r14
	or	r14,r0			; sign CLEAR iff ALL four right of window
	cmpq	#0,r0
	jump	PL,(r22)		; whole face right of clip -> skip
	nop
.endif
	sub	r8,r9			; sx1 - sx0
	sub	r8,r20			; sx2 - sx0
	sub	r21,r23			; sy1 - sy0
	sub	r21,r24			; sy2 - sy0
	move	r9,r0
	movei	#bc1,r28
	.if BANKDIET=1
	movefa	r12,r22			; imul32 (bank-1 resident)
	.else
	movei	#imul32,r22
	.endif
	jump	T,(r22)
        move	r24,r1
	nop
bc1:
	move	r0,r25			; p1 = (sx1-sx0)*(sy2-sy0)
	move	r20,r0
	movei	#bc2,r28
	.if BANKDIET=1
	movefa	r12,r22			; imul32 (bank-1 resident)
	.else
	movei	#imul32,r22
	.endif
	jump	T,(r22)
        move	r23,r1
	nop
bc2:
	sub	r0,r25			; ar = p1 - p2
	movei	#pkt_done,r22
	cmpq	#0,r25
	.if ALLCULL=1
	jump	T,(r22)			; LADDER PROBE: cull EVERY face after
	nop				; the stage+project+cull-test cost
	.endif
.if TINYKEEP>0
	; SUB-PIXEL SIGN GUARD -- KEEP DIRECTION (2026-07-27).  Same premise as
	; TINYCULL below: this cull is a signed area over INTEGER pixel coords, so
	; for a face a few pixels across the SIGN is decided by rounding, not by
	; geometry.  But the opposite remedy.  TINYCULL DROPS the coin-flip faces,
	; which fixes back faces wrongly DRAWN.  The two notches bitten out of her
	; CROWN are the other failure: front faces wrongly DROPPED (measured
	; silicon-only; jagemu renders the same ROM's head solid).  So keep them:
	; when |ar| is inside the rounding noise, prefer to DRAW.
	;   cull iff  ar == 0  or  ar < -N        draw everything else
	; ar == 0 is STILL culled, so the dy == 0 edge-walk that never advances --
	; the liveness hang that black-screened KEEPDEGEN -- cannot recur.
	; Replaces the 5 instructions it sits in front of with 5: costs 0 bytes.
	jump	EQ,(r22)		; ar == 0 -> degenerate, skip
	nop
	.if TINYKEEP=32
	addq	#32,r25			; keep back faces of area <= 16 px^2
	.else
	.if TINYKEEP=16
	addq	#16,r25			; keep back faces of area <= 8 px^2
	.else
	.if TINYKEEP=8
	addq	#8,r25			; keep back faces of area <= 4 px^2
	.else
	.if TINYKEEP=4
	addq	#4,r25			; keep back faces of area <= 2 px^2
	.else
	addq	#2,r25			; keep back faces of area <= 1 px^2
	.endif
	.endif
	.endif
	.endif
	jump	MI,(r22)		; ar < -N -> genuinely back-facing, skip
	nop
.else
.if NOBFCULL=1
	; DIAGNOSTIC: disable the SCREEN-SPACE backface cull entirely so the
	; rastered counter reveals how many discards it owns (vs the empty-y
	; skip). Replacing the jump with a nop needs no free register.
	nop
.else
	jump	MI,(r22)		; ar < 0 -> backface, skip
.endif
	nop				;  *** FLIP CULL SENSE: change MI<->PL here if room0_tex
	nop				;      winding turns rooms inside-out ***
.if TINYCULL>0
	; SUB-PIXEL SIGN GUARD (2026-07-25).  This cull is a signed area built from
	; INTEGER pixel coords (sx/sy are stored post-divide, vc_sxp/vc_syp), so for
	; a triangle only a few pixels across the SIGN is decided by rounding, not by
	; geometry.  Measured on Lara's actual head mesh (85 faces, 82 of them tiny
	; tris) over a full turn: 9.4 faces PER FRAME get the wrong sign at LOWRES
	; (5.7 at full res - LOWRES halves sy resolution, so it is 64% worse).  A
	; back face that wins the coin-flip is drawn, which is her FACE painted over
	; the back of her HAIR, wandering as she animates (user, 2026-07-25).  Her
	; faces cannot be caught earlier: runtime blobs carry a DUMMY plane that the
	; STAGEDIET N.C cull always passes, so this test is her only hidden-surface
	; mechanism.
	; |ar| is TWICE the screen area in px^2, so ar <= 2 means area <= 1 px^2 --
	; a face that can never contribute more than a single pixel.  Culling those
	; turns "randomly visible" into "consistently absent" and is safe for room
	; geometry for the same reason (a <=1px sliver cannot open a visible hole).
	; NB: jas -d symbols are CONDITIONAL-ONLY — they cannot be used as an
	; instruction operand and cannot be bridged through .equ (both tested
	; 2026-07-25), so the threshold literal is selected here, not passed in.
.if TINYCULL=4
	cmpq	#4,r25			; ar - 4  (area <= 2 px^2)
.else
	cmpq	#2,r25			; ar - 2  (area <= 1 px^2, the default)
.endif
	jump	MI,(r22)		; ar < N  -> sub-pixel, sign untrustworthy
	nop
	jump	EQ,(r22)		; ar == N -> ditto (also covers the old ar==0)
	nop
.else
.if KEEPDEGEN=1
	; KEEPDEGEN (2026-07-26): DO NOT drop ar == 0 faces.
	; The cull is a signed area over INTEGER pixel coords, so a face only a few
	; pixels across can round to EXACTLY ZERO and be discarded even though it
	; covers real pixels.  Lara's head is 82 tiny tris, silicon's projection
	; divide rounds differently from jagemu's, and the result is the two notches
	; bitten out of her skull ON HARDWARE ONLY (jagemu renders her head solid:
	; 0 interior gaps vs 35 px on silicon).  A genuinely zero-area face rasters
	; nothing, so keeping it costs a wasted y-walk, not a visual artifact.
.else
	jump	EQ,(r22)		; ar == 0 -> degenerate, skip
	nop
.endif
.endif
.endif

	; 16.16 divide mode for the edge-walk slope divides (chain_step + uv_edge)
	movei	#G_DIVCTRL,r0
	moveq	#1,r1
	store	r1,(r0)

;---------------------------------------------------------------------
; TEXTURED EDGE-WALK (gpu_bltex, VERBATIM): screen coords in SX/SY, per-vertex
; (u,v) in U/V; two-chain walk carries x AND (u,v) as 16.16 DDA; per span the
; Blitter affinely texture-maps.  (bltex's next_poly targets become pkt_done.)
;---------------------------------------------------------------------
	; itop = first strict-min sy; ymin; ymax
	.if BANKDIET=1
	movefa	r10,r0			; SY_BUF (bank-1)
	.else
	movei	#SY_BUF,r0
	.endif
	load	(r0),r1			; sy[0]
	moveq	#0,r20			; itop = 0
	nop
	move	r1,r2			; ymin
	move	r1,r3			; ymax
	moveq	#1,r24			; i = 1
scan_loop:
	cmp	r6,r24			; i - n
	movei	#scan_done,r22
	jump	EQ,(r22)
	nop
	move	r24,r0
	shlq	#2,r0
	.if BANKDIET=1
	movefa	r10,r1			; SY_BUF (bank-1)
	.else
	movei	#SY_BUF,r1
	.endif
	add	r1,r0
	load	(r0),r1			; sy[i]
	nop
	nop
	cmp	r2,r1			; sy[i] - ymin
	jr	PL,not_min		; >= ymin -> keep first min
	nop
	move	r1,r2			; ymin = sy[i]
	move	r24,r20			; itop = i
not_min:
	cmp	r3,r1			; sy[i] - ymax
	jr	MI,not_max		; < ymax
	nop
	jr	EQ,not_max		; == ymax
	nop
	move	r1,r3			; ymax = sy[i]
not_max:
	movei	#scan_loop,r22
	jump	T,(r22)
        addq	#1,r24
	nop
scan_done:
	; y0 = max(ymin,CLIPY0) -> r10 ; y1 = min(ymax,CLIPY1) -> r11
	move	r2,r10			; y = ymin
	movei	#CLIPY0,r0
	load	(r0),r1
	nop
	nop
	cmp	r1,r10			; ymin - clipy0
	jr	PL,y0_ok
	nop
	move	r1,r10
y0_ok:
	move	r3,r11			; y1 = ymax
	; bottom EXCLUSIVE (fill convention): on the ymax scanline the chain
	; walker steps PAST the bottom vertex (gw_flat jumps x to an unrelated
	; vertex, slope 0) -> occasional full-width 1px streaks at poly bottoms
	subq	#1,r11
	movei	#CLIPY1,r0
	load	(r0),r0
	nop
	nop
	cmp	r0,r11			; ymax - clipy1
	jr	MI,y1_ok		; < clipy1 keep
	nop
	jr	EQ,y1_ok		; == clipy1 keep
	nop
	move	r0,r11			; y1 = clipy1
y1_ok:
	; reject empty: y1 < y0
	cmp	r10,r11			; y1 - y0
	movei	#pkt_done,r22
.if NOEMPTYY=1
	; LAST EXIT (2026-07-30), SAFE VARIANT. Simply removing this skip CRASHED
	; on silicon (red exc_catch border) - a face with y1 < y0 reaches the
	; edge-walk with an inverted row count, the same liveness hazard the
	; TINYKEEP comment records for KEEPDEGEN. So CLAMP instead of skipping:
	; y1 = y0 draws exactly one row, which keeps the range valid while still
	; letting the face through. If the flashing stops, faces are being
	; clamped to an empty y-range by the per-frame portal clip window.
	jr	PL,ey_ok		; y1 >= y0: normal
	nop
	move	r10,r11			; else y1 = y0 (single row, valid range)
ey_ok:
.else
	jump	MI,(r22)
	nop
.endif
	.if LARACOUNT=1
	; HER rastered -> $1C000C, RUNTIME BLOBS ONLY (dummy plane d = $F8000000).
	; (staged - rastered) for her = faces killed by the screen-space guards.
	movei	#LARAF,r0
	load	(r0),r1
	nop
	nop
	movei	#$F8000000,r0
	cmp	r0,r1
	movei	#lc_r_no,r22
	jump	NE,(r22)
	nop
	movei	#$001C000C,r0
	load	(r0),r1
	nop
	nop
	addq	#1,r1
	store	r1,(r0)
lc_r_no:
	.endif
	.if CULLCOUNT=1
	; n_rastered++ : passed N.C + BEXIT + screen-area + XCULL + non-empty
	; y-range -> this face WILL raster >=1 span. cullable = 1 - rast/staged.
	movei	#$001C0004,r0
	load	(r0),r1
	nop
	nop
	addq	#1,r1
	store	r1,(r0)
	.endif
	.if SHADEPASS=1
	.if NOBLIT=0
	movei	#SH_Y0,r0		; ARM the rect shade: this face rasters;
	store	r10,(r0)		; pkt_done shades bbox rows y0..y1
	.endif
	.endif

.if XCULL=1
	; init chain u/v DDA state to 0 (recomputed on first edge step).
	; XCULL byte diet (2026-07-21): AU..BVSL are 8 CONTIGUOUS longs at
	; $F03FA8-C4, so one indexed-store run replaces the 8 movei+store
	; pairs below (-40B; funds XCULL alongside SHADEPASS). Runs BEFORE
	; the chain init because it borrows r14 (ayend not yet live). Gated
	; on XCULL only so every flags-off build stays byte-identical.
	moveq	#0,r0
	movei	#AU,r14
	store	r0,(r14)		; AU
	store	r0,(r14+1)		; AUSL
	store	r0,(r14+2)		; AV
	store	r0,(r14+3)		; AVSL
	store	r0,(r14+4)		; BU
	store	r0,(r14+5)		; BUSL
	store	r0,(r14+6)		; BV
	store	r0,(r14+7)		; BVSL
.endif
	; init chains: aci=bci=itop; ayend=byend=ymin(r2); ax=bx=aslope=bslope=0
	move	r20,r12			; aci
	move	r20,r13			; bci
	move	r2,r14			; ayend
	move	r2,r15			; byend
	moveq	#0,r16			; ax
	moveq	#0,r17			; bx
	moveq	#0,r18			; aslope
	moveq	#0,r19			; bslope

.if XCULL=0
	; init chain u/v DDA state to 0 (recomputed on first edge step)
	moveq	#0,r0
	movei	#AU,r1
	store	r0,(r1)
	movei	#AUSL,r1
	store	r0,(r1)
	movei	#AV,r1
	store	r0,(r1)
	movei	#AVSL,r1
	store	r0,(r1)
	movei	#BU,r1
	store	r0,(r1)
	movei	#BUSL,r1
	store	r0,(r1)
	movei	#BV,r1
	store	r0,(r1)
	movei	#BVSL,r1
	store	r0,(r1)
.endif
	; --- section profile: close TRANSFORM, open RASTER ---
	.if PROFGPU=1
	movei	#VC_REG,r1
	loadw	(r1),r0
	movei	#TS0V,r1
	nop
	load	(r1),r2
	movei	#TACC_X,r22
	nop
	sub	r2,r0
	cmpq	#0,r0
	jr	PL,vcx_ok
	nop
	movei	#525,r2
	add	r2,r0
vcx_ok:
	load	(r22),r1
	nop
	nop
	add	r0,r1
	store	r1,(r22)
	movei	#VC_REG,r1
	loadw	(r1),r0
	movei	#TS0V,r1
	nop
	store	r0,(r1)
	.endif

;---------------------------------------------------------------------
yloop:
.if ODRAWS=1
	; ★ POSITIVE CONTROL for the ODRAWS mechanism.  yloop runs once per RASTER
	; SCANLINE and unquestionably executes.
	; ☠️ HISTORY: this control read ~0 and I concluded both probes sat on a
	; dead rasteriser path.  THAT WAS WRONG - the accumulators were fine and
	; the READOUT's own divisions were underflowing to zero.  Strip the
	; arithmetic out of a panel before drawing any conclusion from it.
	; r0/r1 are free here - the PROFGPU block below uses them the same way.
	movei	#ODP_N,r0
	load	(r0),r1
	nop
	nop
	addq	#1,r1
	store	r1,(r0)
.endif
	; --- section profile: count scanlines (raster_hl / NSCAN = cost/line) ---
	.if PROFGPU=1
	movei	#NSCAN,r0
	load	(r0),r1
	nop
	nop
	addq	#1,r1
	store	r1,(r0)
	.endif
	; ---- chain A: while (y >= ayend && guardA++ <= n)  dir +1 ----
	moveq	#0,r21			; guardA
lchain:
	cmp	r14,r10			; y - ayend
	movei	#lchain_done,r22
	jump	MI,(r22)		; y < ayend -> stop
	nop
	cmp	r6,r21			; guard - n
	jr	EQ,lchain_cont		; guard == n -> allowed
	nop
	movei	#lchain_done,r22
	jump	PL,(r22)		; guard > n -> stop
	nop
lchain_cont:
	addq	#1,r21			; guard++
	move	r12,r24			; cur = aci
	movei	#lc_ret,r8
	movei	#chain_step,r22
	jump	T,(r22)
        moveq	#1,r9
	nop
lc_ret:
	move	r29,r14			; ayend = sy[ni]
	move	r25,r16			; ax    = x
	move	r23,r18			; aslope
	move	r12,r0			; cur   = old aci
	move	r24,r1			; ni
	movei	#AU,r7			; chain A u/v block
.if JMPDIET=1
	; BRANCH DIET (2026-07-25): uv_edge exits with `jump T,(r20)`, and r20
	; pointed at a stub whose ONLY job was to branch to lchain — a taken
	; branch landing on a taken branch.  Every taken branch costs 3 refill
	; ticks (HW-calibrated), and jump_refill is 16.9% of Tom's cycles, so
	; returning STRAIGHT to the loop head deletes 3 ticks per chain step per
	; chain.  r20 is never clobbered inside uv_edge and both of its exits go
	; through r20, so this is a pure equivalence.
	movei	#lchain,r20		; return straight to the loop head
.else
	movei	#lc_uv,r20		; return addr
.endif
	movei	#uv_edge,r22
	jump	T,(r22)
        move	r24,r12
	nop
.if JMPDIET=0
lc_uv:
	movei	#lchain,r22
	jump	T,(r22)
	nop
.endif
lchain_done:

	; ---- chain B: while (y >= byend && guardB++ <= n)  dir -1 ----
	moveq	#0,r21			; guardB
rchain:
	cmp	r15,r10			; y - byend
	movei	#rchain_done,r22
	jump	MI,(r22)
	nop
	cmp	r6,r21
	jr	EQ,rchain_cont
	nop
	movei	#rchain_done,r22
	jump	PL,(r22)
	nop
rchain_cont:
	addq	#1,r21
	movei	#-1,r9			; dir -1
	movei	#rc_ret,r8
	movei	#chain_step,r22
	jump	T,(r22)
        move	r13,r24
	nop
rc_ret:
	move	r29,r15			; byend = sy[ni]
	move	r25,r17			; bx    = x
	move	r23,r19			; bslope
	move	r13,r0			; cur = old bci
	move	r24,r1			; ni
	movei	#BU,r7			; chain B u/v block
.if JMPDIET=1
	movei	#rchain,r20		; return straight to the loop head (see lchain)
.else
	movei	#rc_uv,r20		; return addr
.endif
	movei	#uv_edge,r22
	jump	T,(r22)
        move	r24,r13
	nop
.if JMPDIET=0
rc_uv:
	movei	#rchain,r22
	jump	T,(r22)
	nop
.endif
rchain_done:
	; SCANLINE-RUN BATCH: rows until the next chain event (or bottom+1).
	; The inner loop below runs spans WITHOUT chain checks or the r14/r15
	; borrow-restore until this many rows are done. (~25 cyc/scanline off.)
	move	r14,r0			; ayend
	cmp	r15,r0			; ayend - byend
	jr	MI,rb_amin		; ayend smaller -> keep
	nop
	move	r15,r0
rb_amin:
	move	r11,r1			; y1
	addq	#1,r1
	cmp	r1,r0
	jr	MI,rb_ymin
	nop
	move	r1,r0
rb_ymin:
	sub	r10,r0			; nrun = min(ayend,byend,y1+1) - y  (>=1)
	.if BANKDIET=1
	moveta	r0,r4			; run countdown lives in bank-1 r4
	.else
	movei	#RUNC,r1
	store	r0,(r1)
	.endif
	.if RUNHIST=1
	; emu-only probe: RUNHIST_BUF[min(nrun,31)]++  (r1-r3 dead until sp_run)
	move	r0,r2			; nrun
	moveq	#31,r1
	cmp	r1,r2			; nrun - 31
	jr	MI,rh_ok		; nrun < 31: keep
	nop
	move	r1,r2			; clamp to 31
rh_ok:
	shlq	#2,r2
	movei	#RUNHIST_BUF,r1
	add	r1,r2
	load	(r2),r3
	nop
	nop
	addq	#1,r3
	store	r3,(r2)
	.endif
	.if TRAPEZOID=1
	moveq	#0,r21			; BATCHC = 0 (r21 = guardB is dead from
					; here to run end; re-inited per chain)
	.endif

;---------------------------------------------------------------------
; SPAN: choose left/right chain, build affine (u,v) gradient, Blitter fill
;---------------------------------------------------------------------
	; SPAN SECTION register borrow (UNIFIED): r14 (ayend) = DDA base AU..BVSL,
	; r15 (byend) = blitter reg base — both dormant until next scanline's
	; chain checks. Kills 16 movei per scanline vs the address-per-access form.
	.if BANKDIET=1
	moveta	r14,r13			; ayend stash -> bank-1 (was the GDU
	moveta	r15,r14			; slot + RSAVE: 2 movei+store SRAM
					; round-trips per run, now 2 moveta)
	.else
	movei	#GDU,r0
	store	r14,(r0)
	movei	#RSAVE,r0
	store	r15,(r0)
	.endif
	movei	#AU,r14
	movei	#$F02200,r15
	.if RUNBATCH=1
	; RUNBATCH gate, ONCE PER RUN (the tz autopsy: per-row gates ate the
	; win on the 79% of steps that can never batch). Batch only SLOPE-0
	; runs — axis-aligned edges, floors never move, the stable-floor
	; histogram's fat tail (46% of rows) — whose texture drift per row
	; is under the tz bound (1/32 texel: <=1 texel shear over 32 rows).
	; RUNBATCH gate, once per run. EXACT-K era (the stale-xl law: +-1px
	; edge error = +-du TEXELS on minified faces — only exact floor-stable
	; batches are texture-safe). Gate = cheap prefilter only: texture
	; drift under the tz bound (shear <= k*2048 <= 1 texel at k<=31);
	; the launch row computes exact k from the edge fracs.
	moveq	#0,r1
	bset	#11,r1			; 2048 = 1/32 texel/row
	moveq	#0,r0
	moveta	r0,r7			; default: not batchable
	load	(r14+1),r0		; AUSL
	load	(r14+5),r2		; BUSL
	load	(r14+3),r3		; AVSL
	sub	r0,r2			; dUSL
	load	(r14+7),r0		; BVSL
	abs	r2
	sub	r3,r0			; dVSL
	abs	r0
	or	r2,r0			; both under 2048 == OR under 2048
	cmp	r1,r0
	jr	PL,rbg_no		; texture drifts too fast
	moveq	#1,r0			; slot: benign on exit
	moveta	r0,r7			; batchable run
rbg_no:
	.endif
	.if ROWDIET=1
	; ROWDIET run-level invariants (PERFHUNT_CAMPAIGN.md): set integer
	; DIVCTRL ONCE per run (the only in-run divides are the span du/dv;
	; uv_edge/chain_step 16.16 divides happen at chain events, outside the
	; run — 16.16 restored at run exit) and hold the packet clip window in
	; r4/r21 (both dead in-run at TRAPEZOID=0: guards re-init per chain,
	; LEFTP/BATCHC are TRAPEZOID-only; imul32 preserves r4-r25).
	movei	#G_DIVCTRL,r0
	moveq	#0,r1
	store	r1,(r0)
	movei	#CLIPX0,r0
	load	(r0),r4
	movei	#CLIPX1,r0
	load	(r0),r21
	.if RCLIPFIX=1
	; ☠️ RIGHT-EXCLUSIVE SPANS NEED AN EXCLUSIVE CLAMP.
	; With SHADEEXCL=1 a span covers xl..xr-1 (see the fill-convention note at
	; sp_fill: both blits exclusive so adjacent faces neither double-OR nor
	; leave a bright 1px seam). But xr is clamped to CLIPX1, which is
	; INCLUSIVE (gpu_geotex_setclip(0, 319, ...)), so the rightmost span stops
	; at 318 and COLUMN 319 IS NEVER PAINTED - measured black in every scene:
	; caves, mansion and a spawn arm all showed exactly one dead column at
	; x=319. Clamping to CLIPX1+1 makes the exclusive end land on 320, so the
	; last covered pixel is 319. Left edge is unaffected (inclusive already).
	addq	#1,r21
	.endif
	.endif
sp_run:
	.if TRAPEZOID=1
	; BATCHC skip: this row was already drawn by a multi-row blit —
	; advance the loop state only (sp_tail), no span setup/launch.
	cmpq	#0,r21
	jr	EQ,tz_live
	nop
	movei	#sp_tail,r22
	jump	T,(r22)
	subq	#1,r21			; slot: BATCHC--
tz_live:
	.endif
	move	r16,r0
	sharq	#16,r0			; xa
	move	r17,r1
	sharq	#16,r1			; xb
	cmp	r1,r0			; xa - xb
	movei	#sp_bleft,r22
	jump	PL,(r22)		; xa >= xb -> chain B is LEFT
	nop
	; --- chain A is LEFT ---
	move	r0,r2			; xl_raw = xa
	.if TRAPEZOID=1
	move	r14,r4			; LEFTP = &AUSL (indexed loads need
	addq	#4,r4			; r14/r15 base -> keep a direct ptr)
	.endif
	load	(r14),r24		; uL = AU
	load	(r14+2),r25		; vL = AV
	load	(r14+4),r26		; uR = BU
	load	(r14+6),r27		; vR = BV
	movei	#sp_have,r22
	jump	T,(r22)
        move	r1,r3
	nop
sp_bleft:
	; --- chain B is LEFT ---
	move	r1,r2			; xl_raw = xb
	move	r0,r3			; xr_raw = xa
	.if TRAPEZOID=1
	move	r14,r4			; LEFTP = &BUSL
	addq	#20,r4
	.endif
	or	r24,r24			; consumes for the hazard checker: the
	or	r25,r25			; A-left loads it thinks are pending are
	or	r26,r26			; on the OTHER branch of the 1325 jump
	or	r27,r27			; (path-insensitive scan; reported to cobweb)
	load	(r14+4),r24		; uL = BU
	load	(r14+6),r25		; vL = BV
	load	(r14),r26		; uR = AU
	load	(r14+2),r27		; vR = AV
sp_have:
	; (per-poly gradient cache REVERTED: projection is perspective, so du/dv
	; varies per scanline — caching the first span's gradient sheared textures.)
	; denom = xr_raw - xl_raw  (>= 0)
	move	r3,r7
	sub	r2,r7			; r7 = denom
	.if DIVZGUARD=1
	; denom==0 (single-column span) DIVIDES BY ZERO below, on purpose --
	; see the note further down. jsim returns $FFFFFFFF and renders fine;
	; silicon's result is UNMEASURED. Measured 2026-07-27: the shipping
	; kernel does ~45 GPU divide-by-zeros per frame and every one of them
	; is this site (the other four divides are all guarded). Force denom
	; to 1 so the quotient is defined; a 1-px span never consumes it, so
	; the value itself does not matter -- only that silicon computes
	; something rather than something undefined.
	; Placed IMMEDIATELY after the sub so its Z flag is still live.
	jr	NE,sp_dnz
	nop
	moveq	#1,r7
sp_dnz:
	.endif
	; integer divide mode for the per-span du/dv divide
	.if ROWDIET=0
	movei	#G_DIVCTRL,r0
	moveq	#0,r1
	store	r1,(r0)
	.endif
	; (denom==0 single-column spans flow through: div-by-zero returns
	;  garbage du/dv, which one-pixel spans never consume)
	.if DIVHIDE=1
	; DIVHIDE (PACING step 4): both quotients cook in r28/r27 (dead on the
	; off==0 fast path) instead of r0, so the ENTIRE span setup — clamps,
	; off, bwait, A1_PIXEL/FPIXEL packs — runs under the divides. Sign
	; fixes move to the consume points in sp_fill; rd_off1 gets a shim.
	; Requires ROWDIET=1 (Makefile-enforced), TRAPEZOID=0.
	; du = (uR - uL) / denom   (16.16), quotient parks in r28
	move	r26,r28
	sub	r24,r28			; uR - uL
	move	r28,r8			; keep SIGN in r8 (fixed at consume)
	abs	r28
	div	r7,r28			; |num|/denom COOKS in r28; r0 stays free
	.else
	; du = (uR - uL) / denom   (16.16)
	move	r26,r0
	sub	r24,r0			; uR - uL
	move	r0,r8			; keep sign
	abs	r0
	div	r7,r0			; |num| / denom  (integer mode; COOKS while
					;  the clamps below run - div-hide, minimal)
	.endif
	; xl = max(xl_raw,CLIPX0) -> r29   (r5 scratch; r0 is the div dest)
	.if ROWDIET=1
	move	r2,r29
	cmp	r4,r29			; r4 = CLIPX0 (run-resident)
	jr	PL,sp_xlok
	nop
	move	r4,r29
	.else
	move	r2,r29
	movei	#CLIPX0,r5
	load	(r5),r5
	nop
	nop
	cmp	r5,r29
	jr	PL,sp_xlok
	nop
	move	r5,r29
	.endif
sp_xlok:
	; xr = min(xr_raw,CLIPX1) -> r23
	.if ROWDIET=1
	move	r3,r23
	cmp	r21,r23			; r21 = CLIPX1 (run-resident)
	jr	MI,sp_xrok
	nop
	jr	EQ,sp_xrok
	nop
	move	r21,r23
	.else
	move	r3,r23
	movei	#CLIPX1,r5
	load	(r5),r5
	nop
	nop
	cmp	r5,r23
	jr	MI,sp_xrok
	nop
	jr	EQ,sp_xrok
	nop
	move	r5,r23
	.endif
sp_xrok:
	.if DIVHIDE=1
	; dv = (vR - vL) / denom — issue stalls only until du's divider frees
	; (~4 cycles left after the clamps); then dv cooks in r27 under the
	; skip/off checks + bwait + A1_PIXEL/FPIXEL packs in sp_fill.
	sub	r25,r27			; vR - vL in place (r27 = quotient reg)
	move	r27,r9			; SIGN parks in r9
	abs	r27
	div	r7,r27			; |dv| cooks in r27
	.else
	cmpq	#0,r8
	jr	PL,sp_dup		; short fwd branch (jr saves the movei)
	nop
	neg	r0
sp_dup:
	move	r0,r8			; du -> r8
	; dv = (vR - vL) / denom
	move	r27,r0
	sub	r25,r0
	move	r0,r9			; keep sign
	abs	r0
	div	r7,r0
	cmpq	#0,r9
	jr	PL,sp_dvp		; short fwd branch
	nop
	neg	r0
sp_dvp:
	move	r0,r9			; dv -> r9
	.endif
	; (dead jr-to-next deleted for near-band bytes; the alignment-luck
	;  argument died when the band code re-rolled the layout anyway)
sp_clamp:
	; restore 16.16 divide mode for the next scanline's edge slopes
	; (ROWDIET: hoisted to the run exit — no divides until a chain event)
	.if ROWDIET=0
	movei	#G_DIVCTRL,r0
	moveq	#1,r1
	store	r1,(r0)
	.endif
	; (x clamps hoisted between the du issue and read - div-hide)
	; if xr < xl -> skip span
	cmp	r29,r23			; xr - xl
	movei	#sp_skip,r22
	jump	MI,(r22)
	nop

	; off = xl - xl_raw  (>=0; advance the gradient over any left clamp)
	move	r29,r1
	sub	r2,r1			; off (kept in r1; imul32 preserves r1)
	; FAST PATH: off == 0 for every span that doesn't cross the left screen
	; edge (nearly all) -> u0/v0 are just uL/vL; skip BOTH imul32 calls.
	.if ROWDIET=1
	; ROWDIET: the fast path FALLS THROUGH to sp_fill (the multiply path
	; moved out of line to rd_off1, after pkt_done) — one taken jump per
	; span removed from the hot row loop.
	cmpq	#0,r1
	movei	#rd_off1,r22
	jump	NE,(r22)		; off != 0 -> out-of-line multiply path
	move	r24,r7			; slot: u0 = uL (harmless off-path:
					; rd_off1 rewrites r7)
	move	r25,r20			; v0 = vL; fall through
	.else
	cmpq	#0,r1
	jr	NE,sp_off1		; off != 0 -> full multiply path
	nop
	move	r24,r7			; u0 = uL
	movei	#sp_fill,r22
	jump	T,(r22)
        move	r25,r20
	nop
sp_off1:
	; u0 = uL + du*off
	movei	#sp_u0,r28
	.if BANKDIET=1
	movefa	r12,r22			; imul32 (bank-1 resident)
	.else
	movei	#imul32,r22
	.endif
	jump	T,(r22)
        move	r8,r0
	nop
sp_u0:
	add	r24,r0			; u0 = uL + du*off
	move	r0,r7			; u0 (16.16) -> r7
	; v0 = vL + dv*off   (r1 still = off)
	movei	#sp_v0,r28
	.if BANKDIET=1
	movefa	r12,r22			; imul32 (bank-1 resident)
	.else
	movei	#imul32,r22
	.endif
	jump	T,(r22)
        move	r9,r0
	nop
sp_v0:
	add	r25,r0			; v0 = vL + dv*off
	move	r0,r20			; v0 (16.16) -> r20
	.endif
sp_fill:
	.if TRAPEZOID=1
	; ---- TRAPEZOID: texture drift gates FIRST — du/dv change per row =
	; (RSL-LSL)/w; batch only while |BUSL-AUSL| and |BVSL-AVSL| < 2048
	; (1/32 texel per row -> <1 texel right-edge shear over 32 rows).
	; A gate failure forces n=1 so the lookahead exits with k=1 (no
	; extra branch). r24-r27 (uL..vR) are dead here; r0-r3/r5 scratch.
	movei	#RUNC,r5
	load	(r5),r0			; n = rows left in this run
	load	(r14+1),r1		; AUSL
	load	(r14+5),r2		; BUSL
	load	(r14+3),r3		; AVSL
	sub	r1,r2			; BUSL-AUSL
	load	(r14+7),r1		; BVSL
	abs	r2
	sub	r3,r1			; BVSL-AVSL
	abs	r1
	moveq	#0,r3
	.if DRIFTLOOSE=1
	bset	#16,r3			; DIAG ONLY: 1 texel/row drift allowed
	.else
	bset	#11,r3			; 2048 = 1/32 texel/row
	.endif
	cmp	r3,r2			; |dUSL| - 2048
	jr	PL,tz_gfail		; u gradient drifts too fast
	cmp	r3,r1			; slot: v-test flags
	jr	MI,tz_gok		; v ok -> gates passed
	nop
tz_gfail:
	moveq	#1,r0			; n = 1: lookahead yields k=1
tz_gok:
	; ---- rectangle-run lookahead: k (r5) = rows, starting with this
	; one, whose floor(ax) AND floor(bx) both stay put; capped by n.
	move	r16,r26
	sharq	#16,r26			; fa = floor(ax)
	move	r17,r27
	sharq	#16,r27			; fb = floor(bx)
	move	r16,r24
	add	r18,r24			; ta = ax + aslope
	move	r17,r25
	add	r19,r25			; tb = bx + bslope
	moveq	#1,r5			; k = 1
tz_look:
	cmp	r0,r5			; k - n
	jr	PL,tz_kdone		; k >= n: run exhausted
	move	r24,r3			; slot: harmless on exit (r3 scratch)
	sharq	#16,r3
	cmp	r26,r3
	jr	NE,tz_kdone		; left edge about to move
	move	r25,r3			; slot: harmless on exit
	sharq	#16,r3
	cmp	r27,r3
	jr	NE,tz_kdone		; right edge about to move
	add	r18,r24			; slot: harmless on exit (r24 dead)
	add	r19,r25
	jr	T,tz_look
	addq	#1,r5			; slot: k++
tz_kdone:
	.endif

;---- Blitter textured-span fill (gpu_bltex, BYTE-IDENTICAL) -----------
; live: r29=xl r23=xr r10=y  r7=u0(16.16) r20=v0(16.16) r8=du(16.16) r9=dv(16.16)
;       [TRAPEZOID=1: + r5=k rows batchable, r4=LEFTP]
	.if DIVHIDE=1
	; DIVHIDE: spin on r5, NOT r0 — a load into r0 while the (pre-DIVHIDE)
	; divide had r0 as destination was the WAW trap; with quotients in
	; r28/r27 the spin itself now runs UNDER the dv divide.
	.if BANKDIET=1
	movefa	r3,r2			; BLIT_GUARD (bank-1 resident)
	.else
	movei	#BLIT_GUARD,r2
	.endif
	load	(r15+14),r5		; prime the first status read
bwait:
	btst	#0,r5			; idle? (bit0 set = idle)
	jr	NE,bwait_done		; idle -> proceed
	subq	#1,r2			; slot: guard-- (benign on exit)
	cmpq	#0,r2
	jr	NE,bwait		; guard remaining -> spin again
	load	(r15+14),r5		; slot: NEXT status read (benign on exit)
bwait_done:
	or	r5,r5			; settle the in-flight slot load
	.else
.if BWOVER=1
	; ---- BLITTER-WAIT OVERLAP (2026-07-27) -----------------------------
	; MEASURED on a matched in-game scene: 12.66 bwait polls per span, and
	; 92.1% of them find the Blitter BUSY -- so Tom is genuinely waiting,
	; not paying loop-entry overhead. The poll loop costs 18.31% of Tom's
	; cycles (the `blit_wait` counter's 4.75% counts only the modelled
	; stall, NOT the cost of executing the loop -- do not judge Blitter
	; pressure by that counter).
	; None of the four register VALUES below depend on the Blitter being
	; idle; only the STORES do, because writing a Blitter register while a
	; transfer is live corrupts it. So compute them HERE and leave only the
	; stores after the wait: the Blitter gets ~20 more instructions of
	; runway per span, which is time Tom was spending on nothing.
	; r24-r27 are DEAD here -- uL/vL/uR/vR were consumed by the du/dv
	; divides in sp_dvp and by u0/v0 in sp_clamp -- so they carry the
	; results across the wait. r0-r3 stay scratch and are re-armed below.
	; A1_INC = (dv & $FFFF0000) | (du >> 16)
	move	r9,r24
	.if BANKDIET=1
	movefa	r1,r1			; $FFFF0000 (bank-1 resident)
	.else
	movei	#$FFFF0000,r1
	.endif
	and	r1,r24
	move	r8,r2
	shrq	#16,r2
	or	r2,r24
	; A1_FINC = (dv << 16) | (du & $FFFF)
	move	r9,r25
	shlq	#16,r25
	move	r8,r2
	.if BANKDIET=1
	movefa	r2,r3			; $0000FFFF (bank-1 resident)
	.else
	movei	#$0000FFFF,r3
	.endif
	and	r3,r2
	or	r2,r25
	; A2_PIXEL = (y<<16) | xl
	move	r10,r26
	shlq	#16,r26
	or	r29,r26
	; B_COUNT = (1<<16) | (xr - xl + 1)
	move	r23,r27
	sub	r29,r27
	addq	#1,r27
	movei	#$00010000,r1
	or	r1,r27
.endif
	.if BANKDIET=1
	movefa	r3,r2			; BLIT_GUARD (bank-1 resident)
	.else
	movei	#BLIT_GUARD,r2
	.endif
	load	(r15+14),r0		; prime the first status read
bwait:
	; SOFTWARE-PIPELINED spin (2026-07-20): the next status load rides the
	; loop-back delay slot, the guard decrement rides the exit slot —
	; 5 slots/iteration (was 9), no wasted delay slots. Both slot
	; instructions are harmless on the exit paths.
	btst	#0,r0			; idle? (bit0 set = idle)
	jr	NE,bwait_done		; idle -> proceed
	subq	#1,r2			; slot: guard-- (benign on exit)
	cmpq	#0,r2
	jr	NE,bwait		; guard remaining -> spin again
	load	(r15+14),r0		; slot: NEXT status read (benign on exit)
bwait_done:
	or	r0,r0			; settle the in-flight slot load before
					; r0 is rewritten (jas-caught TRM bug 13)
	.endif
	.if PHRASESHADE=1
	; A2 back to PIXEL xadd for the textured span (the shade blit at
	; pkt_done flips it to PHRASE; blitter is idle here so the store is
	; safe; ~2 instr/span, dwarfed by span cost)
	movei	#$00014218,r1		; PITCH1|PIXEL8|WID320|XADDPIX
	store	r1,(r15+10)
	.endif
	.if UVFIX=1
	; FIX (2026-07-25): clamp the span's STARTING texel to the atlas.
	; UVPROBE measured u0 reaching 8191 in a 256-wide atlas and v0 going
	; NEGATIVE. 8191 = $1FFF is exactly the 13-bit mask result, i.e. a
	; NEGATIVE u turned positive by the logical shlq#19/shrq#19 that strips
	; the per-corner shade-k bits. Sampling u=8191 walks ~32 atlas rows away
	; -> the long-standing streaks. Clamp u0 to [0,255], v0 to [0,1031].
	movei	#$00FF0000,r1		; 255.0
	cmp	r1,r7			; u0 - 255.0
	jr	MI,uf_u_ok
	nop
	move	r1,r7
uf_u_ok:
	movei	#$04070000,r1		; 1031.0
	cmp	r1,r20			; v0 - 1031.0
	jr	MI,uf_v_hi
	nop
	move	r1,r20
uf_v_hi:
	cmpq	#0,r20
	jr	PL,uf_v_ok
	nop
	moveq	#0,r20			; v0 was negative -> atlas top
uf_v_ok:
	.endif
	.if UVPROBE=1
	; DIAGNOSTIC (2026-07-25): OR-accumulate every span's STARTING texel
	; coords so out-of-range starts are visible as high bits set.
	;   $1C0010 |= u0 (16.16)   legit u <= 255  -> only bits 16-23 should set
	;   $1C0014 |= v0 (16.16)   legit v <= 1031 -> only bits 16-25 should set
	; Bits 24+/26+ (or bit 31 = negative) prove a bad edge-walk start.
	; r1/r2 are both reloaded by the pack below, so clobbering them is safe.
	movei	#$001C0010,r1
	load	(r1),r2
	or	r7,r2
	store	r2,(r1)
	movei	#$001C0014,r1
	load	(r1),r2
	or	r20,r2
	store	r2,(r1)
	.endif
	.if UVNEG=1
	; ROOT-CAUSE FIX (2026-07-25): clamp the span start to >= 0, LOW SIDE ONLY.
	; The pack below is not sign-safe: u0 goes through `shrq #16` (LOGICAL), so
	; a u0 of $FFFF8000 (-0.5) packs as 65535 rather than -1; and v0 goes
	; through `and $FFFF0000`, which keeps the sign bits, so a v0 of $FFFF0000
	; (-1.0) packs as v=65535. A span whose start lands a FRACTION of a texel
	; negative therefore samples a MAXIMAL texel coordinate -> the streaks.
	; Only the LOW side is wrong, and clamping it needs no atlas bounds — which
	; is exactly why UVFIX's upper clamp to [0,255]/[0,1031] regressed Lara:
	; the upper half was never the necessary part, and it hardcoded the ROOM
	; atlas while build_lara_part passes its own atlasW/g_ltx_atH.
	; Branchless max(x,0): x & ~(x >> 31 arithmetic). 8 instructions, no movei,
	; no branch, no delay slots. r2/r3 are scratch here — the pack rewrites
	; both immediately below.
	; BYTE BUDGET (re-measured 2026-07-25): +16 B on the SHIPPED play flag set
	; is 3532 -> 3548 of 3680 — 132 B SPARE, and XCULL stays on. The earlier
	; "3684, 4 B over" was sized against a kernel built with BANKDIET and
	; ROWDIET off, which is not what ships. This is not byte-blocked.
	move	r7,r2
	sharq	#31,r2			; -1 if u0 < 0 else 0
	not	r2
	and	r2,r7			; u0 = max(u0, 0)
	move	r20,r3
	sharq	#31,r3			; -1 if v0 < 0 else 0
	not	r3
	and	r3,r20			; v0 = max(v0, 0)
	.endif
	; A1_PIXEL = (v0 & $FFFF0000) | (u0 >> 16)   integer texel start (v<<16)|u
	move	r20,r0
	.if BANKDIET=1
	movefa	r1,r1			; $FFFF0000 (bank-1 resident)
	.else
	movei	#$FFFF0000,r1
	.endif
	and	r1,r0			; v0 integer part in bits 16-31
	move	r7,r2
	shrq	#16,r2			; u0 integer part in bits 0-15
	or	r2,r0
	store	r0,(r15+3)
	; A1_FPIXEL = (v0 << 16) | (u0 & $FFFF)      fractional texel start
	move	r20,r0
	shlq	#16,r0			; v0 fraction in bits 16-31
	move	r7,r2
	.if BANKDIET=1
	movefa	r2,r3			; $0000FFFF (bank-1 resident)
	.else
	movei	#$0000FFFF,r3
	.endif
	and	r3,r2			; u0 fraction in bits 0-15
	or	r2,r0
	store	r0,(r15+6)
	.if DIVHIDE=1
	; consume the cooked quotients: apply the parked signs. r28 (du) has
	; been done for ~25 cycles; r27 (dv) cooked under the bwait + packs.
	cmpq	#0,r8
	jr	PL,dh_dup
	nop
	neg	r28
dh_dup:
	cmpq	#0,r9
	jr	PL,dh_dvp
	move	r28,r8			; slot: du (signed) commit — benign
					; both paths (r28 final either way)
	neg	r27
dh_dvp:
	move	r27,r9			; dv (signed 16.16) -> r9
	.endif
	.if UVCLAMP=1
	; DIAGNOSTIC (2026-07-25): clamp the per-pixel texel step to +/-64.0.
	; Hypothesis: large faces at GRAZING angles get an enormous du/dv, which
	; overflows A1_INC's 16-bit integer fields (du>>16 / dv&$FFFF0000) and
	; wraps the sampler, producing streaks parallel to the face edge. A sane
	; face never steps 64 texels per pixel, so this is a no-op for good
	; geometry and a visible fix for the degenerate ones.
	movei	#$00400000,r1		; +64.0 in 16.16
	cmp	r1,r8			; du - LIM
	jr	MI,uc_du_lo
	nop
	move	r1,r8
uc_du_lo:
	movei	#$FFC00000,r1		; -64.0
	cmp	r1,r8			; du + LIM
	jr	PL,uc_du_ok
	nop
	move	r1,r8
uc_du_ok:
	movei	#$00400000,r1
	cmp	r1,r9			; dv - LIM
	jr	MI,uc_dv_lo
	nop
	move	r1,r9
uc_dv_lo:
	movei	#$FFC00000,r1
	cmp	r1,r9			; dv + LIM
	jr	PL,uc_dv_ok
	nop
	move	r1,r9
uc_dv_ok:
	.endif
.if BWOVER=1
	; BWOVER: the four values were computed BEFORE the wait (see the block
	; at sp_fill). Only the stores remain here -- they must follow the wait
	; because the Blitter was still transferring until bwait_done.
	store	r24,(r15+7)		; A1_INC
	store	r25,(r15+8)		; A1_FINC
	store	r26,(r15+12)		; A2_PIXEL
	store	r27,(r15+15)		; B_COUNT
.else
	; A1_INC = (dv & $FFFF0000) | (du >> 16)     integer per-pixel U:V step
	move	r9,r0
	.if BANKDIET=1
	movefa	r1,r1			; $FFFF0000 (bank-1 resident)
	.else
	movei	#$FFFF0000,r1
	.endif
	and	r1,r0			; dv integer step in bits 16-31
	move	r8,r2
	shrq	#16,r2			; du integer step in bits 0-15
	or	r2,r0
	store	r0,(r15+7)
	; A1_FINC = (dv << 16) | (du & $FFFF)        fractional per-pixel step
	move	r9,r0
	shlq	#16,r0			; dv fraction step in bits 16-31
	move	r8,r2
	.if BANKDIET=1
	movefa	r2,r3			; $0000FFFF (bank-1 resident)
	.else
	movei	#$0000FFFF,r3
	.endif
	and	r3,r2			; du fraction step in bits 0-15
	or	r2,r0
	store	r0,(r15+8)
	; A2_PIXEL = (y<<16) | xl                    dest span start
	move	r10,r0
	shlq	#16,r0
	or	r29,r0
	store	r0,(r15+12)
	; B_COUNT = (k<<16) | (xr - xl + 1)   k rows (1 unless TRAPEZOID batch)
	move	r23,r0
	sub	r29,r0
.if SHADEEXCL=1
	; CONSISTENT FILL CONVENTION (2026-07-30): left-inclusive, RIGHT-EXCLUSIVE
	; for the texture blit too. Making only the SHADE span exclusive left every
	; span's last pixel textured but unshaded -> a bright 1px line down the
	; right edge of every face (reported immediately). With BOTH exclusive,
	; face A covers xl..xr-1 and face B starts exactly at xr: no pixel is
	; covered twice (no double-OR, no flicker) and none is skipped (no lines).
	; Same convention already used vertically ("bottom EXCLUSIVE").
	; npix == 0 (a 1px span) must skip: a 0 count blits 65536 pixels.
	cmpq	#0,r0
	movei	#sp_skip,r22
	jump	EQ,(r22)
	nop
.else
	addq	#1,r0			; npix = xr-xl+1
.endif
	.if TRAPEZOID=1
	move	r5,r1
	shlq	#16,r1
	move	r0,r3			; npix copy for the batch epilogue
	.else
	.if RUNBATCH=1
	move	r0,r3			; npix copy for the batch path
	.endif
	movei	#$00010000,r1
	.endif
	or	r1,r0
	store	r0,(r15+15)
.endif
.if ODRAW=1
	; OVERDRAW PROBE (2026-07-28) -- EMULATOR ONLY, NEVER FLASH THIS.
	; Accumulate every span's npix into $1C0020 so the total pixels the
	; Blitter actually transfers can be divided by (frames x 320 x 120).
	; blit_transfer is 32.9% of Tom and batching cannot touch it (measured
	; null), so the only remaining lever on it is drawing FEWER PIXELS --
	; and nobody has ever measured how many are redundant.
	; A DRAM read-modify-write in the kernel is exactly the shape that
	; black-screened silicon as LARACOUNT, hence emulator-only.
	movei	#$001C0020,r1
	load	(r1),r2
	move	r23,r3
	sub	r29,r3
	addq	#1,r3			; npix = xr-xl+1 (recomputed; r0 is live)
	add	r3,r2
	store	r2,(r1)
.endif
.if ODRAWS=1
	; ★ SAFE OVERDRAW PROBE (2026-08-10) - the one above can never answer the
	; question.  Two reasons: (a) its DRAM read-modify-write is the shape that
	; black-screened silicon as LARACOUNT, so it is emulator-only, and (b) the
	; OFFLINE HARNESS NEVER RASTERISES - jtest completes the kernel with the
	; vertex cache written but NOT ONE SPAN EMITTED (verified at four yaws,
	; 2026-08-10), so ODRAW reads exactly 0 there and always would.
	;
	; This accumulates into GPU SRAM instead, which the kernel writes on every
	; face already, and the 68k reads it once per frame with Tom idle.
	;   ODP_PX = total span pixels, ODP_N = span count
	; pixels/frame vs 320x120 = the overdraw factor; pixels/spans = the mean
	; span length, which decides between "draw fewer pixels" and "draw fewer,
	; longer spans".
	; ☠️ Lives in the PROFGPU block, so ODRAWS=1 needs STAGEDIET=0 - a
	; measurement arm, not the ship build.  r0 is LIVE here; r1/r2/r3 are the
	; scratch the probe above already established.
	movei	#ODP_PX,r1
	load	(r1),r2
	move	r23,r3
	sub	r29,r3
	addq	#1,r3			; npix = xr-xl+1
	add	r3,r2
	store	r2,(r1)
.endif
	; B_CMD = SRCEN|LFU_REPLACE|DSTA2 -> LAUNCH
	.if NOFILL=0
	; EXPERIMENT HALFSPAN: launch only even scanlines (timing probe)
	.if HALFSPAN=1
	btst	#0,r10
	jr	NE,sp_nolaunch
	nop
	.endif
	.if TRAPEZOID=1
	cmpq	#1,r5
	movei	#tz_plain,r22
	jump	EQ,(r22)		; k == 1: classic single-row launch
	moveq	#0,r1			; slot: benign on both paths
	; ---- batched k-row launch (d=0 rectangle run) ----
	; A2_STEP = (1<<16)|((-npix)&$FFFF): +1 row, X re-home (v4b pattern,
	; UPDA2-steps-DSTA2-dest silicon-confirmed; (r15+13)=$F02234)
	bset	#17,r1			; $20000  (r3 = npix, saved at B_COUNT)
	sub	r3,r1
	store	r1,(r15+13)		; A2_STEP
	; A1_STEP/FSTEP = (LVSL,LUSL) - npix*(dv,du): the npix*d term cancels
	; the inner loop's own pointer advance, so row i starts EXACTLY at
	; (uL,vL) + i*(LUSL,LVSL) — even w=1 garbage-du spans stay exact.
	load	(r4),r24		; LUSL (r4 = &LUSL, set at chain pick)
	addq	#8,r4
	load	(r4),r25		; LVSL
	move	r3,r1			; npix (imul32 preserves r1)
	movei	#tz_mu,r28
	.if BANKDIET=1
	movefa	r12,r22			; imul32 (bank-1 resident)
	.else
	movei	#imul32,r22
	.endif
	jump	T,(r22)
        move	r8,r0			; slot: du
tz_mu:
	sub	r0,r24			; su = LUSL - npix*du
	movei	#tz_mv,r28
	.if BANKDIET=1
	movefa	r12,r22			; imul32 (bank-1 resident)
	.else
	movei	#imul32,r22
	.endif
	jump	T,(r22)
        move	r9,r0			; slot: dv
tz_mv:
	sub	r0,r25			; sv = LVSL - npix*dv
	; pack 16.16 pair -> A1_STEP (ints) / A1_FSTEP (fracs), v:u
	move	r25,r0
	shrq	#16,r0
	shlq	#16,r0			; sv int bits 16-31, low cleared
	move	r24,r2
	shrq	#16,r2
	or	r2,r0
	store	r0,(r15+4)		; A1_STEP  ($F02210)
	move	r25,r0
	shlq	#16,r0			; sv frac bits 16-31
	move	r24,r2
	shlq	#16,r2
	shrq	#16,r2			; su frac bits 0-15
	or	r2,r0
	store	r0,(r15+5)		; A1_FSTEP ($F02214)
	move	r5,r21			; BATCHC = k-1 rows to skip
	subq	#1,r21
	movei	#$01800F01,r0		; BCMD_TEX|UPDA1F|UPDA1|UPDA2
	jr	T,tz_store		; LAUNCH k rows
	nop
tz_plain:
	.endif
	.if RUNBATCH=1
	; K-ROW LAUNCH: on a batchable run, one blit draws ALL k remaining
	; rows of the run (B_COUNT rows field + UPDA2 row-rehome from v4b +
	; UPDA1/UPDA1F per-row texture stepping from the tz machinery — both
	; silicon-proven). The next k-1 loop iterations skip via BATCHC.
	movefa	r7,r1			; batchable run?
	cmpq	#0,r1
	movei	#rb_single,r22
	jump	EQ,(r22)		; drift-hostile run: per-row spans
	move	r16,r0			; slot: kcalc arg (benign on exit)
	; EXACT k, DIV-HIDDEN (silicon lesson: the GPU divide has NO dest
	; interlock — an early quotient read is GARBAGE and the real quotient
	; lands up to ~38 cycles LATER over whatever now owns the register;
	; the emu's value-correct model hid this and silicon crawled at
	; 0.14 fps). Unified formula, no post-fix:
	;   slope>0: k = (($10000-frac)+slope-1)/slope   (ceil)
	;   slope<0: k = (frac+|slope|)/|slope|          (floor(frac/|s|)+1)
	;   slope=0: k = 31
	; Schedule: issue divA -> prep B (hide) -> issue divB (the divider-
	; busy stall completes A) -> read A -> RUNC/31 min (hide) -> read B.
	; r0 = ax (from the slot above).
	shlq	#16,r0
	shrq	#16,r0			; frac(ax)
	move	r18,r1			; aslope
	moveq	#31,r24			; k_a default (slope 0)
	cmpq	#0,r1
	jr	EQ,rb_kb0		; slope 0: skip div A
	nop
	jr	MI,rb_ka1
	nop
	moveq	#0,r2
	bset	#16,r2
	sub	r0,r2			; $10000 - frac
	add	r1,r2
	subq	#1,r2
	jr	T,rb_ka2
	move	r2,r24			; slot: numerator -> r24 (div dest)
rb_ka1:
	neg	r1			; |aslope|
	move	r0,r24
	add	r1,r24			; frac + |slope|
rb_ka2:
	div	r1,r24			; k_a COOKS in r24
rb_kb0:
	; --- edge B prep (this IS div A's hide window) ---
	move	r17,r0
	shlq	#16,r0
	shrq	#16,r0			; frac(bx)
	move	r19,r1			; bslope
	moveq	#31,r25			; k_b default (slope 0)
	cmpq	#0,r1
	jr	EQ,rb_kbz		; slope 0: skip div B
	nop
	jr	MI,rb_kb1
	nop
	moveq	#0,r2
	bset	#16,r2
	sub	r0,r2
	add	r1,r2
	subq	#1,r2
	jr	T,rb_kb2
	move	r2,r25			; slot: numerator -> r25
rb_kb1:
	neg	r1
	move	r0,r25
	add	r1,r25
rb_kb2:
	div	r1,r25			; k_b COOKS (issue-stall retires div A)
rb_kbz:
	; --- div B's HIDE WINDOW: all k-INDEPENDENT batch setup runs here
	; (~50 cycles) so both quotients are long retired before any read.
	; r24/r25 are the COOKING div dests: nothing below touches them —
	; LUSL/LVSL live in r5/r20 (both dead: k unset, v0 consumed).
	moveq	#0,r1
	bset	#17,r1
	sub	r3,r1			; (1<<16)|((-npix)&$FFFF)
	store	r1,(r15+13)		; A2_STEP: +1 row, X re-home
	move	r3,r7			; npix -> r7: imul32 CLOBBERS r3 (bLo
					; scratch) and B_COUNT packs after the
					; imuls now — r3-garbage npix launched
					; runaway 65K-px blits (silicon wedge)
	; which chain is LEFT: re-derive from the LIVE DDAs (r2/xl_raw is
	; pack-clobbered — the slab lesson). B-left iff floor(ax)>=floor(bx).
	move	r16,r1
	sharq	#16,r1			; floor(ax)
	move	r17,r2
	sharq	#16,r2			; floor(bx)
	cmp	r2,r1			; xa - xb
	jr	MI,rb_la		; xa < xb: A is left
	moveq	#0,r1			; slot: offset = A block
	moveq	#16,r1			; B block
rb_la:
	add	r1,r14
	load	(r14+1),r5		; LUSL (NOT r24/r25 — divs cooking!)
	load	(r14+3),r20		; LVSL
	sub	r1,r14			; r14 -> AU base again
	or	r5,r5			; settle both loads before the imul32
	or	r20,r20			; jumps (load-across-jump erratum)
	move	r3,r1			; npix (imul32 preserves r1)
	movei	#rb_mu,r28
	.if BANKDIET=1
	movefa	r12,r22			; imul32 (bank-1 resident)
	.else
	movei	#imul32,r22
	.endif
	jump	T,(r22)
	move	r8,r0			; slot: du (bank-0)
rb_mu:
	sub	r0,r5			; su = LUSL - npix*du: row i starts
	movei	#rb_mv,r28		; EXACTLY at (uL,vL)+i*(LUSL,LVSL)
	.if BANKDIET=1
	movefa	r12,r22			; imul32 (bank-1 resident)
	.else
	movei	#imul32,r22
	.endif
	jump	T,(r22)
	move	r9,r0			; slot: dv
rb_mv:
	sub	r0,r20			; sv = LVSL - npix*dv
	move	r20,r0
	shrq	#16,r0
	shlq	#16,r0
	move	r5,r2
	shrq	#16,r2
	or	r2,r0
	store	r0,(r15+4)		; A1_STEP  (v:u ints)
	move	r20,r0
	shlq	#16,r0
	move	r5,r2
	shlq	#16,r2
	shrq	#16,r2
	or	r2,r0
	store	r0,(r15+5)		; A1_FSTEP (v:u fracs)
	; --- NOW consume k: both divides retired ~40+ cycles ago ---
	movefa	r4,r0			; RUNC (rows left incl this one)
	moveq	#31,r2
	cmp	r2,r0
	jr	MI,rb_m1		; RUNC < 31: keep
	nop
	move	r2,r0			; bound = min(RUNC,31)
rb_m1:
	cmp	r0,r24			; k_a - bound
	jr	MI,rb_m2
	nop
	move	r0,r24
rb_m2:
	cmp	r24,r25			; k_b - k_a
	jr	PL,rb_m3
	nop
	move	r25,r24			; k = min(k_a, k_b, RUNC, 31)
rb_m3:
	move	r24,r1
	cmpq	#4,r1
	movei	#rb_single,r22
	jr	PL,rb_go		; k >= 4: batch (jump cost ~200 cyc
	nop				;   loses on k=2-3)
	moveq	#0,r2			; hostile fracs: stop paying kcalc on
	moveta	r2,r7			; this run's later rows
	jump	T,(r22)			; -> single-row launch (the A2_STEP/
	nop				;    A1_STEP stores above are inert:
					;    BCMD_TEX has no UPDA1/UPDA2)
rb_go:
	move	r1,r5
	subq	#1,r5			; k-1 -> r5 (su packed; r5 free again)
	shlq	#16,r1
	or	r7,r1			; npix from r7 (r3 died in imul32)
	store	r1,(r15+15)		; B_COUNT = (k<<16)|npix (overwrites
					; the single-row value stored earlier)
	movei	#$01800F01,r0		; BCMD_TEX|UPDA1F|UPDA1|UPDA2
	store	r0,(r15+14)		; LAUNCH k rows (blitter draws while
					; the DDA-jump below runs)
	; --- DDA-JUMP: advance ALL loop state k-1 rows arithmetically ---
	; (replaces BATCHC row-skipping: no per-row check tax on live rows,
	; no walked sp_tail per skipped row. r5 = k-1.)
	movefa	r12,r22			; imul32 (r22 was rb_single here!)
	move	r5,r1			; k-1 (imul32 preserves r1)
	movei	#rj_xa,r28
	jump	T,(r22)
	move	r18,r0			; slot: aslope
rj_xa:
	add	r0,r16			; ax += (k-1)*aslope
	movei	#rj_xb,r28
	jump	T,(r22)
	move	r19,r0			; slot: bslope
rj_xb:
	add	r0,r17			; bx += (k-1)*bslope
	; uv DDAs: walk the 4 (val,slope) pairs at AU..BVSL via r14 itself
	; (indexed loads allow only r14/r15 bases); restore base after.
	.if RBNOUV=1
	movei	#rj_skipuv,r28		; [BISECT] uv-jump disabled: batches
	jump	T,(r28)			; smear textures but isolate the wedge
	nop
	.endif
	moveq	#3,r25			; 4 slots (r24/r25 dead: LUSL consumed)
rj_uv:
	load	(r14+1),r0		; slope of this slot
	movei	#rj_uv1,r28
	or	r0,r0			; SETTLE the load before the taken jump
					; (Tom erratum: a load consumed across
					; a jump is garbage on silicon — the
					; kernel's own or-settle idiom)
	jump	T,(r22)
	move	r5,r1			; slot: k-1
rj_uv1:
	load	(r14),r2
	nop
	add	r0,r2			; val += (k-1)*slope
	store	r2,(r14)
	addq	#8,r14
	subq	#1,r25
	jr	NE,rj_uv
	nop
	subq	#32,r14			; r14 -> AU base again
	.if RBNOUV=1
rj_skipuv:
	.endif
	add	r5,r10			; y += k-1
	movefa	r4,r0
	sub	r5,r0
	moveta	r0,r4			; RUNC -= k-1
	jr	T,sp_skip		; final row's advance happens in
	nop				; sp_tail as normal (total = k rows)
rb_single:
	.endif
	movei	#BCMD_TEX,r0
tz_store:
	store	r0,(r15+14)
.if SPANSHADE>0
	; ---- PER-SPAN SHADE (2026-07-28) ---------------------------------
	; The pkt_done pass shades ONE RECT over the face's BOUNDING BOX. For a
	; triangle that is ~2x the face's area, and the overshoot is exactly
	; what paints the floating shaded chunks (A2) and the grey outline
	; (A3): hard axis-aligned rectangles that ignore the geometry, plainly
	; visible in a shade-difference map of the frame. Shade the span's
	; ACTUAL extent instead, immediately after its texture blit.
	; TRADE: +1 wait and +1 launch per span, but ~half the shade transfer
	; (exact extent instead of bbox). Which dominates is MEASURED.
	; k == 0 means full bright -> no shade blit at all (the common case
	; for Lara, who never gets a runtime k).
	; A2_STEP is safe to clobber: the rect version already does, and the
	; texture path re-arms everything it needs per span.
	movei	#SHADEK,r1
	load	(r1),r2			; k byte pattern
	nop
	nop
	cmpq	#0,r2
	movei	#ss_none,r22
	jump	EQ,(r22)		; full bright -> skip
	nop
	; The texture blit must RETIRE before we read-modify-write its pixels.
	; SETTLE FIRST: the Blitter takes several cycles after the B_CMD store
	; to assert BUSY, so polling immediately reads the STALE idle bit,
	; sails straight through, and the register writes below corrupt the
	; in-flight texture blit (black wedges, measured). The existing bwait
	; never hits this because a whole span's setup sits between its launch
	; and its poll. Two dummy status reads are a bus round-trip each --
	; far longer than the busy-assert delay.
	load	(r15+14),r1
	nop
	nop
	or	r1,r1			; settle read 1
	load	(r15+14),r1
	nop
	nop
	or	r1,r1			; settle read 2
ss_bw:
	load	(r15+14),r1		; blit status
	nop
	nop
	btst	#0,r1			; idle?
	jr	EQ,ss_bw
	nop
	; SCRATCH: r0/r1/r2 ONLY. **r4 IS CLIPX0 AND IS RUN-RESIDENT** (see the
	; `cmp r4,r29` left-clip test in the span setup) -- clobbering it wrecks
	; the left clip for every remaining span of the run, which is exactly
	; the black wedges on the LEFT of the frame this cost me. sp_tail treats
	; r0/r1/r2 as scratch, so those are the safe ones.
	move	r10,r1
	shlq	#16,r1
	or	r29,r1
	store	r1,(r15+12)		; A2_PIXEL = (y<<16)|xl
	move	r23,r0
	sub	r29,r0
.if SHADEEXCL=1
	; RIGHT-EXCLUSIVE (2026-07-30): the texture blit and this one both used
	; xr-xl+1, inclusive BOTH ends, so where two faces share an edge pixel E
	; the texture pass just overwrites (last wins, invisible) but the shade
	; pass ORs -> E gets k_A|k_B, darker than either face asked for. That is
	; the flickering-tile artifact: it appears only where neighbouring tiles
	; have DIFFERENT k, and the affected pixel changes as coverage shifts.
	; Dropping the +1 makes E belong solely to the face that also owns its
	; texel. width 0 (a 1px span) must skip: a 0 count blits 65536 pixels.
	cmpq	#0,r0
	movei	#ss_none,r22
	jump	EQ,(r22)
	nop
.else
	addq	#1,r0			; width = xr - xl + 1
.endif
	moveq	#0,r1
	bset	#17,r1
	sub	r0,r1			; (1<<16)|((-width)&$FFFF)
	store	r1,(r15+13)		; A2_STEP
	movei	#$00010000,r1
	or	r0,r1
	store	r1,(r15+15)		; B_COUNT = (1 row<<16)|width
	store	r2,(r15+16)		; B_SRCD = k pattern
	store	r2,(r15+17)
	; NOTE: the rect version's B_CMD carries UPDA1, which advances the A1
	; pointer -- A1 is the TEXTURE SOURCE. That is harmless at pkt_done
	; (the next face re-arms A1 completely) but NOT mid-face: it would
	; corrupt the very next span's texture fetch. Drop it here.
	; FIXED 2026-07-30: was $01C00E00. The comment claimed it dropped UPDA1,
	; but UPDA1 is bit 8 ($100) - the bit actually cleared was bit 3 ($08) =
	; DSTEN. Without DSTEN the blit never READS the destination, so the LFU
	; (S|D) collapses to S and the k pattern is written straight OVER the
	; texture: the whole world renders as flat untextured colour on silicon
	; (jagemu does not model this and showed it correct, which is how the
	; per-span path got recorded as "pixel-equivalent"). The SPANSHADE=2
	; bisect confirmed the setup writes are harmless and the fault is the
	; launch. Same value as the rect blit; UPDA1 is not set in either.
	movei	#$01C00E08,r1		; DSTEN | LFU(S|D) | DSTA2 | UPDA2
.if SPANSHADE=2
	; BISECT ARM: run ALL of the setup above (the wait, and the writes to
	; A2_PIXEL / A2_STEP / B_COUNT / B_SRCD) but DO NOT LAUNCH. If the
	; frame renders clean, my register writes are harmless and the fault
	; is in the shade blit itself; if it is still broken, the setup is
	; corrupting state the texture path depends on.
	or	r1,r1			; consume r1; no launch
.else
	store	r1,(r15+14)		; LAUNCH (next span's bwait covers it)
.endif
ss_none:
.endif
sp_nolaunch:
	.endif

sp_skip:
sp_tail:
	; advance the two x DDAs ...
	add	r18,r16			; ax += aslope
	add	r19,r17			; bx += bslope
	.if RUNHIST=1
	; STABLE-FLOOR sub-run probe (RUNBATCH kill-check v2): histogram at
	; RUNHIST_BUF+$100 of consecutive rows where floor(ax) AND floor(bx)
	; both held still across the step — the exact batchable-row criterion.
	; Streak cell at +$200. r0-r3 scratch here (uv-DDA reloads them below).
	movei	#rh2_moved,r22
	move	r16,r0
	sub	r18,r0			; old ax
	sharq	#16,r0			; old floor
	move	r16,r1
	sharq	#16,r1
	cmp	r0,r1
	jump	NE,(r22)
	nop
	move	r17,r0
	sub	r19,r0
	sharq	#16,r0
	move	r17,r1
	sharq	#16,r1
	cmp	r0,r1
	jump	NE,(r22)
	nop
	movei	#RUNHIST_BUF+$200,r1
	load	(r1),r2
	movei	#rh2_done,r22
	nop
	addq	#1,r2
	store	r2,(r1)
	jump	T,(r22)
	nop
rh2_moved:
	movei	#RUNHIST_BUF+$200,r1
	load	(r1),r2
	moveq	#31,r0
	nop
	cmp	r0,r2
	jr	MI,rh2_c
	nop
	move	r0,r2
rh2_c:
	shlq	#2,r2
	movei	#RUNHIST_BUF+$100,r0
	add	r0,r2
	load	(r2),r3
	moveq	#0,r0
	nop
	addq	#1,r3
	store	r3,(r2)
	movei	#RUNHIST_BUF+$200,r1
	store	r0,(r1)
rh2_done:
	.endif
	; ... and the four u/v DDAs via r14-INDEXED addressing (AU..BVSL are 8
	; consecutive longs). r14 (ayend) is dormant between chain updates;
	; stashed in the dead GDU slot for the duration.
	load	(r14),r0		; AU (r14 = AU base since span entry)
	load	(r14+1),r1		; AUSL
	load	(r14+2),r2		; AV
	load	(r14+3),r3		; AVSL
	add	r1,r0
	store	r0,(r14)		; AU += AUSL
	add	r3,r2
	store	r2,(r14+2)		; AV += AVSL
	load	(r14+4),r0		; BU
	load	(r14+5),r1		; BUSL
	load	(r14+6),r2		; BV
	load	(r14+7),r3		; BVSL
	add	r1,r0
	store	r0,(r14+4)		; BU += BUSL
	add	r3,r2
	store	r2,(r14+6)		; BV += BVSL
	; y++ and the RUN countdown: stay in the tight span loop (r14 = AU,
	; r15 = blitter base persist) until the next chain event row
	.if BANKDIET=1
	movefa	r4,r1			; run countdown (bank-1 resident: the
	addq	#1,r10			; y++    movei+load+store SRAM RMW gone)
	movefa	r5,r22			; sp_run target (bank-1 resident)
	subq	#1,r1
	moveta	r1,r4
	cmpq	#0,r1
	jump	NE,(r22)		; rows left in this run -> next span
	nop
	.else
	movei	#RUNC,r0
	load	(r0),r1
	addq	#1,r10			; y++ (fills RUNC load latency)
	movei	#sp_run,r22		; hoisted target (fills 2nd slot)
	subq	#1,r1
	store	r1,(r0)
	cmpq	#0,r1
	jump	NE,(r22)		; rows left in this run -> next span
	nop
	.endif
	; run ended: restore ayend/byend for the chain checks
	.if BANKDIET=1
	movefa	r13,r14			; restore ayend (bank-1 stash)
	movefa	r14,r15			; restore byend
	.else
	movei	#GDU,r0
	movei	#RSAVE,r1
	load	(r0),r14		; restore ayend
	load	(r1),r15		; restore byend
	.endif
	.if ROWDIET=1
	movei	#G_DIVCTRL,r2		; restore 16.16 divide mode for the
	moveq	#1,r3			; chain/uv_edge divides (also hides
	store	r3,(r2)			; the r14/r15 load latency)
	.endif
	cmp	r11,r10			; y - y1 (fills the load latency)
	movei	#yloop,r22
	jump	MI,(r22)		; y < y1 -> chains again
	nop
	jump	EQ,(r22)		; y == y1 -> last line
	nop
	; fall through to pkt_done

;---------------------------------------------------------------------
; pkt_done: face rendered (or skipped) -> back to the face iterator.
pkt_done:
	.if NOBLIT=0
	.if SHADEPASS=1
	; RECT-SHADE LAUNCH v4b: ONE multi-row OR blit per face over the
	; face-tight vertex bbox (SX_BUF x r6), clamped to the packet clip.
	; r14 = SHADEK base for indexed var access ((r14+6) = SH_Y0); r15
	; becomes the Blitter base. Both are dead chain state at pkt_done.
	or	r14,r14			; settle the run-end restore's in-flight
					; load into r14 (jas-caught TRM bug 13)
	movei	#SHADEK,r14
	load	(r14),r2		; k pattern
	.if SPANSHADE>0
	; SPANSHADE owns the shading now: each span shaded its own exact
	; extent at launch, so the bounding-box rect must NOT also run.
	;
	; ---- BUT THE LAST SPAN'S SHADE BLIT IS STILL IN FLIGHT (2026-08-01) ----
	; Every span launches its shade blit and leaves it uncovered on the
	; grounds that "the next span's bwait covers it". The LAST span of a face
	; has no next span: control arrives here and goes straight back to the
	; face iterator, which re-arms A1/A2/B_COUNT for the NEXT face while that
	; shade blit is still running. That is precisely the corruption this file
	; already documents two screens up -- "the register writes below corrupt
	; the in-flight texture blit (black wedges, measured)".
	; It flickers rather than being constant because whether it bites depends
	; on how much iterator code happens to run before the next launch, and on
	; the stale-BUSY window: the next face's own bwait can poll before the
	; Blitter has asserted BUSY for OUR blit and sail straight through.
	; That is the black flickering tiles the user reported the moment
	; SPANSHADE went in, and the ragged notches measured in Lara's hair.
	; So close the face here, with the same settle-then-poll the per-span
	; wait uses. Only when k != 0 -- if the face was full-bright no shade
	; blit was ever launched and waiting would just stall on the texture
	; blit, which the next face's bwait already covers.
	; r15 is dead chain state at pkt_done (the rect arm below clobbers it
	; with A1_BASE too and never restores it), so it is safe scratch.
	movei	#shx_none,r22
	nop
	nop				; SHADEK load latency before the test
	cmpq	#0,r2			; k == 0 -> nothing was ever launched
	jump	EQ,(r22)
	nop
	movei	#A1_BASE,r15
	load	(r15+14),r1		; settle read 1 (bus round-trip)
	nop
	nop
	or	r1,r1
	load	(r15+14),r1		; settle read 2
	nop
	nop
	or	r1,r1
pd_bw:
	load	(r15+14),r1		; blit status
	nop
	nop
	btst	#0,r1			; idle?
	jr	EQ,pd_bw
	nop
	movei	#shx_none,r22
	jump	T,(r22)
	nop
	.endif
	.if SPANSHADE=0
	; The whole bounding-box rect shade below is UNREACHABLE when SPANSHADE
	; is on (the arm above jumps straight to shx_none), and the kernel has a
	; hard 3680-byte ceiling before the SRAM vars at F03E60. Assembling out
	; dead code is what pays for the face-end blit wait added above.
	load	(r14+6),r0		; SH_Y0: clipped y0, -1 = never rastered
	movei	#shx_none,r22
	cmpq	#0,r2
	jump	EQ,(r22)		; k = 0: full bright
	cmpq	#0,r0			; slot: arm-flag flags (safe both paths)
	jump	MI,(r22)		; culled/empty face: not armed
	nop
	; bbox: r3 = min sx, r4 = max sx over n staged verts
	.if BANKDIET=1
	movefa	r11,r1			; SX_BUF (bank-1)
	.else
	movei	#SX_BUF,r1
	.endif
	load	(r1),r3
	move	r6,r5			; n = face vert count (live)
	subq	#1,r5
	move	r3,r4			; XL = XR = sx[0]
shx_vl:
	addq	#4,r1
	load	(r1),r7
	subq	#1,r5
	cmp	r7,r3			; XL - sx (load latency: subq+this)
	jr	MI,shx_v1		; XL < sx: keep
	cmp	r7,r4			; slot: XR-test flags (move keeps flags)
	move	r7,r3			; XL = min
shx_v1:
	jr	PL,shx_v2		; XR >= sx: keep
	cmpq	#0,r5			; slot: loop-counter flags
	move	r7,r4			; XR = max
shx_v2:
	jr	NE,shx_vl
	nop
	; clamp to the packet clip rect (behind-camera verts project garbage)
	.if PHRASESHADE=1
	; (CLIPX0/1 = SHADEK+$30/$34: indexed loads off live r14 — the 12B
	; this saves vs two moveis FUNDS the PHRASESHADE code below. Gated so
	; flags-off stays byte-identical to the shipped kernel.)
	load	(r14+12),r5		; CLIPX0
	load	(r14+13),r1		; CLIPX1
	.else
	movei	#CLIPX0,r1
	load	(r1),r5
	movei	#CLIPX1,r1
	load	(r1),r1
	.endif
	cmp	r5,r3			; XL - clipx0
	jr	PL,shx_c1		; XL >= clipx0: keep
	cmp	r1,r4			; slot: XR-vs-clipx1 flags
	move	r5,r3			; XL = clipx0
shx_c1:
	jr	MI,shx_c2		; XR < clipx1: keep
	nop
	move	r1,r4			; XR = clipx1
shx_c2:
	.if PHRASESHADE=1
	; PHRASE-MODE shade (PACING campaign step 4): the OR pass was the
	; kernel's only pixel-mode DSTEN blit — 1 RMW bus pair PER PIXEL.
	; Phrase mode does 8 px per RMW pair. X start aligns DOWN to a
	; phrase, width rounds UP to whole phrases: <=7px of extra OR-bleed
	; each side of a rect that already overshoots (vertex bbox), same
	; artifact class as v4b. A2_STEP keeps PIXEL units (width8);
	; B_COUNT inner count becomes PHRASES (width8>>3).
	cmp	r3,r4			; XR - XL
	jump	MI,(r22)		; fully clipped out: skip
	moveq	#7,r5			; slot: mask seed (benign on exit)
	not	r5			; r5 = ~7
	and	r5,r3			; XL &= ~7: phrase-aligned start
	sub	r3,r4			; XR - XLa
	addq	#8,r4			; +1 (width) +7 (round-up)
	and	r5,r4			; width8 = whole phrases in pixels
	.else
	cmp	r3,r4			; XR - XL
	jump	MI,(r22)		; fully clipped out: skip (width would
	sub	r3,r4			; slot: width-1     wrap huge = disaster)
	addq	#1,r4			; width = XR-XL+1
	.endif
	movei	#A1_BASE,r15		; Blitter base for indexed stores
shx_bw:
	load	(r15+14),r1		; blit status
	move	r11,r5			; slot-fill: rows = y1 (r11 live) ...
	sub	r0,r5			;   ... - y0 (recomputed per spin: fine)
	btst	#0,r1
	jr	EQ,shx_bw
	nop
	addq	#1,r5			; rows = y1-y0+1
	.if PHRASESHADE=1
	movei	#$00004218,r1		; A2_FLAGS -> PHRASE xadd (PITCH1|
	store	r1,(r15+10)		;   PIXEL8|WID320|XADDPHR); blitter
					;   idle here (spin above). Restored
					;   per-span at bwait_done.
	.endif
	shlq	#16,r0
	or	r3,r0
	store	r0,(r15+12)		; A2_PIXEL = (y0<<16)|XL (phrase-
					;   aligned under PHRASESHADE)
	moveq	#0,r1
	bset	#17,r1			; $20000
	sub	r4,r1			; = (1<<16)|((-width)&$FFFF)
	store	r1,(r15+13)		; A2_STEP ($F02234! NOT +8=$F02220=
					; A1_FINC — the A2 register file is
					; not parallel to A1: A2_MASK at $2C)
	shlq	#16,r5
	or	r4,r5
	store	r5,(r15+15)		; B_COUNT = (rows<<16)|width — PIXELS
					; even under PHRASESHADE (the counter
					; is always pixels; XADDPHR only packs
					; the ACCESSES into phrases — confirmed
					; against jag-core blit.rs, and a /8
					; count made A2_STEP drag X negative
					; every row = fb-wide OR garbage)
	store	r2,(r15+16)		; B_SRCD  = k pattern
	store	r2,(r15+17)
	movei	#$01C00E08,r1		; DSTEN|LFU(S|D)|DSTA2|UPDA1|UPDA2
	store	r1,(r15+14)		; LAUNCH (next face's bwait covers it)
	.endif				; SPANSHADE=0 (dead rect-shade path)
shx_none:
	moveq	#0,r1
	subq	#1,r1
	store	r1,(r14+6)		; disarm SH_Y0 until the next raster
	.endif
	.endif
	; --- section profile: close RASTER section ---
	.if PROFGPU=1
	movei	#VC_REG,r1
	loadw	(r1),r0
	movei	#TS0V,r1
	nop
	load	(r1),r2
	movei	#TACC_R,r22
	nop
	sub	r2,r0
	cmpq	#0,r0
	jr	PL,vcr_ok
	nop
	movei	#525,r2
	add	r2,r0
vcr_ok:
	load	(r22),r1
	nop
	nop
	add	r0,r1
	store	r1,(r22)
	.endif
	movei	#face_loop,r22
	jump	T,(r22)
	nop


	.if ROWDIET=1
;---------------------------------------------------------------------
; rd_off1 (ROWDIET): out-of-line left-clamp multiply path — the rare
; off != 0 span (crosses the left clip edge).  Entered from the off
; check with r1 = off, r8 = du, r9 = dv, r24 = uL, r25 = vL (imul32
; preserves r1/r4-r25).  Returns to sp_fill with r7 = u0, r20 = v0.
;---------------------------------------------------------------------
rd_off1:
	.if DIVHIDE=1
	; DIVHIDE arm: |quotients| are STILL COOKING in r28/r27 (~32-tick div;
	; we are ~10 ticks past dv's issue). READS of a cooking dest are
	; value-correct; the ONE fatal act is a WRITE into r27/r28 before the
	; divide lands (TRM bug 13: the quotient re-lands LAST, corrupting
	; whatever wrote there — imul32's r27/r28 scratch did exactly that).
	; So: NO imul32 here. off <= 320 fits 16 bits, so |q|*off inlines as
	; two 16x16 mults using only r0/r2 — write-free w.r.t. r27/r28, and
	; smaller than the two imul32 call frames it replaces. Signs stay
	; parked in r8/r9 for the dh consume in sp_fill (shared with the
	; fast path; r8/r9 here hold SIGNED NUMERATORS, sign is all we need).
	; u0 = uL +- |du|*off   (r28 = |du| 16.16, r1 = off)
	move	r28,r0
	shrq	#16,r0			; |du| hi
	mult	r1,r0			; hi*off
	shlq	#16,r0
	move	r28,r2
	shlq	#16,r2
	shrq	#16,r2			; |du| lo
	mult	r1,r2			; lo*off
	add	r2,r0			; |du|*off (16.16)
	cmpq	#0,r8			; du sign (parked numerator)
	jr	PL,rq_up
	nop
	neg	r0
rq_up:
	add	r24,r0			; u0 = uL +- |du|*off
	move	r0,r7
	; v0 = vL +- |dv|*off   (r27 = |dv| 16.16)
	move	r27,r0
	shrq	#16,r0
	mult	r1,r0
	shlq	#16,r0
	move	r27,r2
	shlq	#16,r2
	shrq	#16,r2
	mult	r1,r2
	add	r2,r0
	cmpq	#0,r9			; dv sign
	jr	PL,rq_vp
	nop
	neg	r0
rq_vp:
	add	r25,r0			; v0 = vL +- |dv|*off
	move	r0,r20
	movei	#sp_fill,r22
	jump	T,(r22)
	nop
	.else
	movei	#rd_u0,r28
	.if BANKDIET=1
	movefa	r12,r22			; imul32 (bank-1 resident)
	.else
	movei	#imul32,r22
	.endif
	jump	T,(r22)
        move	r8,r0
	nop
rd_u0:
	add	r24,r0			; u0 = uL + du*off
	move	r0,r7
	movei	#rd_v0,r28
	.if BANKDIET=1
	movefa	r12,r22			; imul32 (bank-1 resident)
	.else
	movei	#imul32,r22
	.endif
	jump	T,(r22)
        move	r9,r0
	nop
rd_v0:
	add	r25,r0			; v0 = vL + dv*off
	move	r0,r20
	movei	#sp_fill,r22
	jump	T,(r22)
	nop
	.endif
	.endif

;=====================================================================
; uv_edge: compute the (u,v) DDA state for one edge cur->ni into the chain
;   block.  gpu_bltex VERBATIM.
;   in:  r0 = cur index, r1 = ni index, r10 = y, r7 = block ptr
;        (block: +0 U(16.16), +4 USL, +8 V, +12 VSL), r20 = return addr.
;   out: block[+0..+12] written.  Preserves r10-r21, r4-r6, r30.  DIV 16.16.
;   clobbers r0-r3, r8, r9, r22-r29.
;=====================================================================
uv_edge:
	move	r0,r24
	shlq	#2,r24			; cur*4
	move	r1,r25
	shlq	#2,r25			; ni*4
	.if BANKDIET=1
	movefa	r10,r2			; SY_BUF (bank-1)
	.else
	movei	#SY_BUF,r2
	.endif
	add	r24,r2
	load	(r2),r26		; sy[cur]
	.if BANKDIET=1
	movefa	r10,r3			; SY_BUF (bank-1)
	.else
	movei	#SY_BUF,r3
	.endif
	add	r25,r3
	load	(r3),r27		; sy[ni]
	nop
	nop
	move	r27,r0
	sub	r26,r0			; dy = sy[ni]-sy[cur]
	move	r10,r1
	sub	r26,r1			; delta = y - sy[cur]
	cmpq	#0,r0
	movei	#uve_flat,r22
	jump	MI,(r22)		; dy < 0
        move	r0,r23
	jump	EQ,(r22)		; dy == 0
        move	r1,r29
	nop
	; ---- dy > 0: U ----
	movei	#U_BUF,r2
	add	r24,r2
	load	(r2),r9			; u[cur]
	movei	#U_BUF,r3
	add	r25,r3
	load	(r3),r0			; u[ni]
	nop
	nop
	move	r0,r8
	sub	r9,r8			; duint = u[ni]-u[cur]
	shlq	#16,r9			; ubase = u[cur]<<16 (persist)
	move	r8,r1
	abs	r1
	div	r23,r1			; (|duint|<<16)/dy
	cmpq	#0,r8
	movei	#uve_us_pos,r22
	jump	PL,(r22)
	nop
	neg	r1
uve_us_pos:
	move	r7,r2
	addq	#4,r2
	store	r1,(r2)			; USL = uslope
	move	r1,r0			; uslope
	movei	#uve_u_ret,r28
	.if BANKDIET=1
	movefa	r12,r22			; imul32 (bank-1 resident)
	.else
	movei	#imul32,r22
	.endif
	jump	T,(r22)
        move	r29,r1
	nop
uve_u_ret:
	add	r9,r0			; u = u[cur]<<16 + uslope*delta
	store	r0,(r7)			; U
	; ---- dy > 0: V ----
	movei	#V_BUF,r2
	add	r24,r2
	load	(r2),r9			; v[cur]
	movei	#V_BUF,r3
	add	r25,r3
	load	(r3),r0			; v[ni]
	nop
	nop
	move	r0,r8
	sub	r9,r8			; dvint
	shlq	#16,r9			; vbase = v[cur]<<16
	move	r8,r1
	abs	r1
	div	r23,r1			; (|dvint|<<16)/dy
	cmpq	#0,r8
	movei	#uve_vs_pos,r22
	jump	PL,(r22)
	nop
	neg	r1
uve_vs_pos:
	move	r7,r2
	addq	#12,r2
	store	r1,(r2)			; VSL = vslope
	move	r1,r0			; vslope
	movei	#uve_v_ret,r28
	.if BANKDIET=1
	movefa	r12,r22			; imul32 (bank-1 resident)
	.else
	movei	#imul32,r22
	.endif
	jump	T,(r22)
        move	r29,r1
	nop
uve_v_ret:
	add	r9,r0			; v = v[cur]<<16 + vslope*delta
	move	r7,r2
	addq	#8,r2
	store	r0,(r2)			; V
	jump	T,(r20)
	nop
uve_flat:
	; dy <= 0: slopes 0, u/v snap to the ni endpoint (matches gw_flat for x)
	moveq	#0,r0
	move	r7,r2
	addq	#4,r2
	store	r0,(r2)			; USL = 0
	move	r7,r2
	addq	#12,r2
	store	r0,(r2)			; VSL = 0
	movei	#U_BUF,r2
	add	r25,r2
	load	(r2),r0			; u[ni]
	movei	#V_BUF,r3
	add	r25,r3
	load	(r3),r1			; v[ni]
	nop
	nop
	shlq	#16,r0			; u[ni]<<16
	store	r0,(r7)			; U
	shlq	#16,r1			; v[ni]<<16
	move	r7,r2
	addq	#8,r2
	store	r1,(r2)			; V
	jump	T,(r20)
	nop

;=====================================================================
; chain_step: advance ONE edge of a chain (VERBATIM; identical in both sources).
;   in:  r24 = cur index, r9 = +1/-1, r10 = y, r6 = n, r8 = return address
;   out: r24 = next index (ni), r23 = slope, r25 = x (16.16), r29 = yend
;   clobbers r0-r3, r22, r26, r27, r28.  Preserves r10-r21.
;=====================================================================
chain_step:
	move	r24,r26			; cur
	add	r9,r24			; ni = cur + dir
	cmpq	#0,r24
	movei	#gw_m1,r22
	jump	PL,(r22)
	nop
	add	r6,r24			; wrapped below 0
gw_m1:
	cmp	r6,r24			; ni - n
	movei	#gw_m2,r22
	jump	MI,(r22)
	nop
	sub	r6,r24			; wrapped past n-1
gw_m2:
	move	r26,r0
	shlq	#2,r0			; cur*4
	move	r24,r1
	shlq	#2,r1			; ni*4
	.if BANKDIET=1
	movefa	r10,r2			; SY_BUF (bank-1)
	.else
	movei	#SY_BUF,r2
	.endif
	add	r0,r2
	load	(r2),r27		; sy[cur]
	.if BANKDIET=1
	movefa	r10,r3			; SY_BUF (bank-1)
	.else
	movei	#SY_BUF,r3
	.endif
	add	r1,r3
	load	(r3),r29		; sy[ni]  (= yend)
	.if BANKDIET=1
	movefa	r11,r2			; SX_BUF (bank-1)
	.else
	movei	#SX_BUF,r2
	.endif
	add	r0,r2
	load	(r2),r25		; sx[cur]
	.if BANKDIET=1
	movefa	r11,r3			; SX_BUF (bank-1)
	.else
	movei	#SX_BUF,r3
	.endif
	add	r1,r3
	load	(r3),r23		; sx[ni]
	move	r29,r0
	sub	r27,r0			; dy = sy[ni]-sy[cur]
	cmpq	#0,r0
	movei	#gw_flat,r22
	jump	MI,(r22)		; dy < 0
	nop
	jump	EQ,(r22)		; dy == 0
	nop
	; --- dy > 0: slope = ((sx[ni]-sx[cur])<<16)/dy ---
	move	r23,r1
	sub	r25,r1			; dx (signed)
	move	r1,r2			; keep dx sign
	abs	r1			; ua = |dx|
	move	r1,r3
	shrq	#16,r3			; ua>>16
	cmp	r0,r3			; (ua>>16) - dy
	movei	#gw_div,r26
	jump	CS,(r26)		; (ua>>16) < dy -> divide
	nop
	movei	#$7FFFFFFF,r1		; saturate (only if dx would overflow)
	movei	#gw_sign,r26
	jump	T,(r26)
	nop
gw_div:
	div	r0,r1			; (ua<<16)/dy  [16.16]
gw_sign:
	cmpq	#0,r2			; dx < 0 ?
	movei	#gw_pos,r26
	jump	PL,(r26)
	nop
	neg	r1
gw_pos:
	move	r1,r23			; slope
	shlq	#16,r25			; sx[cur]<<16 (survivor)
	move	r10,r1
	sub	r27,r1			; delta = y - sy[cur]
	movei	#gw_xret,r28
	.if BANKDIET=1
	movefa	r12,r22			; imul32 (bank-1 resident)
	.else
	movei	#imul32,r22
	.endif
	jump	T,(r22)
        move	r23,r0
	nop
gw_xret:
	add	r25,r0			; x = sx[cur]<<16 + slope*delta
	jump	T,(r8)
        move	r0,r25
	nop
gw_flat:
	move	r23,r25
	shlq	#16,r25			; x = sx[ni]<<16
	jump	T,(r8)
        moveq	#0,r23
	nop

;=====================================================================
; imul32: r0 = low32(r0 * r1).  VERBATIM (identical in both sources).
;   clobbers r2,r3,r26,r27.  return: jump (r28).  Preserves r1,r4-r25,r29.
;=====================================================================
imul32:
.if IMULPROBE=1
	; IMUL FAST-PATH HIT-RATE PROBE (2026-07-28) -- EMULATOR ONLY.
	; imul32 is 7.44% of Tom (~2.3M calls, 16 instructions each) doing a
	; 32x32 product as three 16x16 mults. If BOTH operands fit in 16 bits the
	; two cross terms are zero and ONE `mult` is exact -- but the test that
	; detects it costs ~5 instructions and the saving is ~5, so a fast path
	; is a WASH at a 50% hit rate and only pays well above that.
	; Count total calls at $1C0030 and 16-bit-eligible calls at $1C0034 so
	; the hit rate decides whether the optimisation is worth writing at all.
	movei	#$001C0030,r2
	load	(r2),r3
	nop
	nop
	addq	#1,r3
	store	r3,(r2)
	move	r0,r3
	or	r1,r3
	shrq	#16,r3			; (a|b)>>16 == 0  <=> both fit in 16 bits
	jr	NE,ip_wide
	nop
	movei	#$001C0034,r2
	load	(r2),r3
	nop
	nop
	addq	#1,r3
	store	r3,(r2)
ip_wide:
.endif
	move	r0,r2			; aLo
	move	r1,r3			; bLo
	move	r0,r26
	shrq	#16,r26			; aHi
	move	r1,r27
	shrq	#16,r27			; bHi
	mult	r3,r2			; aLo*bLo
	mult	r27,r0			; aLo*bHi
	mult	r1,r26			; aHi*bLo
	nop
	nop
	add	r26,r0			; cross
	shlq	#16,r0
	jump	T,(r28)
        add	r2,r0
	nop

;=====================================================================
.if NEARCLIP=1
;=====================================================================
; nc_try: one behind vertex -> clip its edge to z = NEAR.
;   in:  r21 = n (verts this face), r20 = face record base (vertex indices),
;        SX_BUF/SY_BUF staged (sentinel in the behind slot), WBUF+4 = world.
;   out: SX_BUF[j]/SY_BUF[j] replaced with the crossing point, or jumps to
;        pkt_done if the face cannot be clipped (0 or >1 behind).
; The arithmetic is the sequence proven offline in tools/clip_math_test.gas:
;   num = A_z - NEAR ; den = A_z - B_z ; P = A + num*(B-A)/den   (world)
; then transform P and project it.  P lies ON the plane, so the projection
; divide is by NEAR (64) - a shift, not a divide.
;=====================================================================
nc_try:
	; --- find the single sentinel slot -> r23 = j, r19 = count ----------
	movefa	r11,r2			; SX_BUF
	moveq	#0,r19			; count
	moveq	#0,r9			; j
	movei	#$07FFFFFF,r3
nc_scan:
	move	r9,r0
	shlq	#2,r0
	add	r2,r0
	load	(r0),r1
	nop
	nop
	cmp	r3,r1
	jr	NE,nc_sn
	nop
	addq	#1,r19
	move	r9,r23			; remember the behind slot
nc_sn:
	addq	#1,r9
	cmp	r21,r9
	jr	NE,nc_scan
	nop
	; exactly one behind vertex, or give up
	cmpq	#1,r19
	movei	#pkt_done,r22
	jump	NE,(r22)
	nop
	; --- neighbour A = (j-1+n) mod n ------------------------------------
	move	r23,r9
	subq	#1,r9
	jr	PL,nc_ha
	nop
	move	r21,r9
	subq	#1,r9
nc_ha:
	; r9 = A slot, r23 = B slot (behind)
	movei	#nc_back,r22		; nothing implemented past here yet -
	jump	T,(r22)			; the face falls through unclipped so
	nop				; this arm is measurable, not live
.endif

; stage_vert: look up an RVert, add the room offset, append WORLD (x,y,z) as
;   3 longs at r14.  gpu_geomdirect VERBATIM.
;   in:  r1 = vertex index (unsigned), r10 = VERTS base, r11 = offX<<8,
;        r12 = yTopD(=0), r13 = offZ<<8, r14 = write ptr, r8 = return addr.
;   out: 3 world longs stored, r14 += 12.
;   clobbers r0,r1,r2,r3,r9.  Preserves r6,r7,r10-r14,r20,r21,r23.
;=====================================================================
stage_vert:
	; VERTEX CACHE lookup (pre-pass transformed every vert once)
	; CACHE STRIDE 8 -> 12 (2026-08-09): the cache now carries the vertex's
	; VIEW-SPACE Z alongside sx/sy.  Near-plane clipping needs the depth of
	; BOTH ends of an edge to find where it crosses z=NEAR, and nothing else
	; in the kernel keeps it - which is why the near plane can only reject
	; whole faces today (the R4 rock that blinks).  idx*12 = idx*8 + idx*4.
	move	r1,r3
	shlq	#3,r1			; idx*8
	shlq	#2,r3			; idx*4
	add	r3,r1			; idx*12 (cache stride)
	movei	#VCACHE_PRM,r0
	load	(r0),r2
	nop
	nop
	add	r2,r1			; &cache[idx]
	load	(r1),r2			; sx (or $07FFFFFF behind)
	addq	#4,r1
	load	(r1),r3			; sy
	move	r6,r9			; j (preserved by convention)
	shlq	#2,r9
	.if BANKDIET=1
	movefa	r11,r0			; SX_BUF (bank-1)
	.else
	movei	#SX_BUF,r0
	.endif
	add	r9,r0
	store	r2,(r0)
	.if BANKDIET=1
	movefa	r10,r0			; SY_BUF (bank-1)
	.else
	movei	#SY_BUF,r0
	.endif
	add	r9,r0
	store	r3,(r0)
	movei	#$07FFFFFF,r0
	cmp	r0,r2
	jr	NE,sv_ok
	nop
.if BEXIT=1
	; BEHIND EARLY-EXIT (BUCKET guard 2): abort the face at the FIRST
	; behind/far-sentinel vertex — the face would only be BEHINDF-skipped
	; after full staging anyway. r21 (n) is live for face_adv's record
	; advance; r22 = where face_adv jumps after advancing the cursor.
.if BEXCNT=1
	; n_bexit++ via an out-of-line stub: counting inline pushed the
	; `jr NE,sv_ok` above past its +-15 word range. The stub is 2 words
	; SMALLER inline than the path it replaces, so the branch gets shorter.
	movei	#bexcnt_stub,r0
	jump	T,(r0)
	nop
.else
	movei	#face_loop,r22
	movei	#face_adv,r0
	jump	T,(r0)
	nop
.endif
.else
	movei	#BEHINDF,r0
	moveq	#1,r2
	store	r2,(r0)
.endif
sv_ok:
	jump	T,(r8)
	nop

;=====================================================================
done:
	; DISPATCH: more rooms queued? -> render the next one
	movei	#LISTMODE,r0
	load	(r0),r1
	nop
	nop
	cmpq	#0,r1
	movei	#room_next,r22
	jump	NE,(r22)
	nop
alldone:
	.if GPUBG=1
	; A10 CYCLE-NEUTRAL PROBE (2026-07-30): paint BG WHITE from TOM, not the
	; 68k. Added 68k instructions flip the A10 race 4-for-4, so the probe must
	; live in a different instruction stream entirely - this leaves main.o /
	; startup.o byte-identical. If the failing build turns WHITE, the GPU
	; reached alldone, set the mailbox and raised CPUINT, and the 68k still
	; never proceeded (=> halted, or the wake was lost). If it stays put, Tom
	; never finished and the 68k is waiting legitimately.
	movei	#$00F00058,r1
	movei	#$0000FFFE,r0
	storew	r0,(r1)
	nop
	nop
	.endif
	movei	#MAGIC_DONE,r0
	store	r0,(r30)		; mailbox[0] = done
	nop
	nop
	.if SYNCDRAIN=1
	; ☠️☠️ MEASURED ON SILICON 2026-08-10: **NO EFFECT.**  Control and drain
	; both read 6.67 fps (267 beacon transitions in 40s) on a pad-muted,
	; scene-identical A/B.  So the race described below either does not happen
	; or costs less than the field it would have to cost to be visible.  The
	; flag is kept OFF and kept documented so the hypothesis is not re-derived
	; from first principles a third time.  See project_syncdrain_wake_race.
	;
	; ☠️ THE STORE ABOVE IS POSTED; THE CPUINT BELOW IS NOT.  mailbox[0] is in
	; DRAM and goes out through the memory controller's write queue, while
	; G_CTRL is an internal Tom register written on the next cycle.  So the
	; interrupt can reach the 68k BEFORE the done-flag lands.  When that
	; happens cpu_stop_unless wakes, re-reads a STALE mailbox, and STOPs
	; again - and the only thing that wakes it now is VBLANK, so the frame
	; pays a WHOLE 16.67ms FIELD (~11% of frame time at 6.6 fps).  That is
	; the mechanism behind gpu_sync's "~8 STOP wakes per frame" and behind
	; the cadence-lock the PACING comment describes.
	;
	; Reading the location back forces the queue to drain (a read of an
	; address with a write in flight cannot be satisfied ahead of it).  This
	; is the SAME protocol dsp_ovl_ent.das already uses before it publishes
	; MAGIC_OVL_DONE - Tom's alldone was simply never given it.
	load	(r30),r0
	nop
	nop
	or	r0,r0			; consume, so the load cannot be elided
	.endif
	; raise a 68k CPU interrupt (G_CTRL CPUINT, bit1; keep GPUGO bit0) so the
	; 68k can sleep in STOP during the whole GPU run instead of bus-polling
	; (68k polling steals DRAM cycles from GPU+Blitter — measured bottleneck).
	movei	#$F02114,r1		; G_CTRL
	moveq	#3,r0			; GPUGO | CPUINT
	store	r0,(r1)
	nop
	nop
halt:
	nop
	jr	T,halt
	nop

	.if BEXCNT=1
;=====================================================================
; bexcnt_stub: a face that PASSED the world-space N.C backface cull (it
; faces the camera) but has a vertex behind the near plane. Count it, then
; resume the normal BEXIT abort: r22=face_loop, jump face_adv.
bexcnt_stub:
	movei	#$001C0010,r0		; NOT $1C0008: LARACOUNT owns that
	load	(r0),r2
	nop
	nop
	addq	#1,r2
	store	r2,(r0)
	movei	#face_loop,r22
	movei	#face_adv,r0
	jump	T,(r0)
	nop
	.endif
